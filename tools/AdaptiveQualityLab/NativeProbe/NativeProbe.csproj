<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- Compile existing native primitives read-only; do not load/start the wallpaper application. -->
    <Compile Include="../../../src/XenMotion.UI/Rendering/Direct3D/GpuFramePipeline.cs" Link="Native/GpuFramePipeline.cs" />
    <Compile Include="../../../src/XenMotion.UI/Rendering/Direct3D/DesktopSwapChain.cs" Link="Native/DesktopSwapChain.cs" />
    <Compile Include="../../../src/XenMotion.UI/Rendering/Direct3D/D3D11NativeMethods.cs" Link="Native/D3D11NativeMethods.cs" />
    <Compile Include="../../../src/XenMotion.UI/Rendering/Media/MediaFoundation*.cs" Link="Native/%(Filename)%(Extension)" />
    <Compile Include="../../../src/XenMotion.UI/Desktop/DesktopSurface.cs" Link="Native/DesktopSurface.cs" />
    <Compile Include="../../../src/XenMotion.UI/Desktop/Win32/DesktopNativeMethods.cs" Link="Native/DesktopNativeMethods.cs" />
    <Compile Include="../../../src/XenMotion.Application/Services/MediaFormatValidator.cs" Link="Native/MediaFormatValidator.cs" />
    <Compile Include="../../../src/XenMotion.Core/Models/MonitorBounds.cs" Link="Models/MonitorBounds.cs" />
    <Compile Include="../../../src/XenMotion.Core/Models/VideoViewportCalculator.cs" Link="Models/VideoViewportCalculator.cs" />
    <Compile Include="../../../src/XenMotion.Core/Enums/PlaybackScalingMode.cs" Link="Models/PlaybackScalingMode.cs" />
  </ItemGroup>
</Project>
