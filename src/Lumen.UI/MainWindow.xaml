<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lumen.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lumen.UI"
    xmlns:vm="using:Lumen.UI.ViewModels"
    xmlns:cat="using:Lumen.Core.Models.Catalog">

  <Grid x:Name="RootGrid" Background="{StaticResource LumenPageBrush}" RequestedTheme="Dark">
    <Grid.Resources>

      <!-- ============================ Explore card ============================ -->
      <DataTemplate x:Key="ExploreCardTemplate" x:DataType="vm:CatalogItemViewModel">
        <Grid Width="236" Height="148" Background="Transparent"
              Tapped="OnCatalogCardTapped" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">
          <Border CornerRadius="20" BorderBrush="{StaticResource LumenRimBrush}" BorderThickness="1">
            <Border.Background>
              <ImageBrush ImageSource="{x:Bind ThumbnailImage}" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <Border Height="78" VerticalAlignment="Bottom" CornerRadius="0,0,20,20" Background="{StaticResource LumenCardScrimBrush}" IsHitTestVisible="False" />
          <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,13" Spacing="1" IsHitTestVisible="False">
            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind local:UiFn.Join(ResolutionText, FormattedSize)}" FontSize="11" Foreground="#C8D5D2" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Border Style="{StaticResource LumenBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="{x:Bind TypeGlyph}" FontSize="10" Foreground="{StaticResource LumenMintTextBrush}" />
              <TextBlock Text="{x:Bind QualityBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
            </StackPanel>
          </Border>
          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Width="24" Height="24" CornerRadius="12"
                  Background="{StaticResource LumenAccentBrush}" Visibility="{x:Bind IsDownloaded, Mode=OneWay}" IsHitTestVisible="False">
            <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource LumenOnAccentBrush}" />
          </Border>
          <ProgressBar VerticalAlignment="Bottom" Margin="14,0,14,0" Height="3" Minimum="0" Maximum="100"
                       Value="{x:Bind DownloadProgress, Mode=OneWay}" Visibility="{x:Bind IsDownloading, Mode=OneWay}" IsHitTestVisible="False" />
          <Grid x:Name="HoverLayer" Opacity="0">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.18" /></Grid.OpacityTransition>
            <Border CornerRadius="20" Background="#66050A12" BorderBrush="{StaticResource LumenAccentRimBrush}" BorderThickness="1" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button Style="{StaticResource LumenRoundOverlayButtonStyle}" Tag="{x:Bind}" Click="OnCatalogViewClicked" ToolTipService.ToolTip="Preview">
                <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE7B3;" FontSize="16" />
              </Button>
              <Button Style="{StaticResource LumenPrimaryButtonStyle}" Width="44" Height="44" MinHeight="44" Padding="0" CornerRadius="22"
                      Tag="{x:Bind}" Click="OnCatalogActionClicked" ToolTipService.ToolTip="{x:Bind ActionButtonText, Mode=OneWay}">
                <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="{x:Bind local:UiFn.ActionGlyph(IsDownloaded, IsDownloading), Mode=OneWay}" FontSize="16" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </DataTemplate>

      <!-- ============================ Library card ============================ -->
      <DataTemplate x:Key="LibraryCardTemplate" x:DataType="vm:WallpaperItemViewModel">
        <Grid Width="276" Height="172" Background="Transparent" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">
          <Border CornerRadius="22" BorderBrush="{StaticResource LumenRimBrush}" BorderThickness="1">
            <Border.Background>
              <ImageBrush ImageSource="{x:Bind ThumbnailImage}" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <Border CornerRadius="22" BorderBrush="{StaticResource LumenAccentRimBrush}" BorderThickness="2" Visibility="{x:Bind IsActive, Mode=OneWay}" IsHitTestVisible="False" />
          <Border Height="86" VerticalAlignment="Bottom" CornerRadius="0,0,22,22" Background="{StaticResource LumenCardScrimBrush}" IsHitTestVisible="False" />
          <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,14" Spacing="1" IsHitTestVisible="False">
            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind DetailsText}" FontSize="11" Foreground="#C8D5D2" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Border Style="{StaticResource LumenBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" IsHitTestVisible="False">
            <TextBlock Text="{x:Bind TypeBadge}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
          </Border>
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,48,0,0" CornerRadius="10" Padding="9,4"
                  Background="{StaticResource LumenAccentBrush}" Visibility="{x:Bind IsActive, Mode=OneWay}" IsHitTestVisible="False">
            <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{StaticResource LumenOnAccentBrush}" />
          </Border>
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,48,0,0" CornerRadius="10" Padding="9,4"
                  Background="{StaticResource LumenDangerSoftBrush}" Visibility="{x:Bind IsMissing}" IsHitTestVisible="False">
            <TextBlock Text="FILE MISSING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LumenDangerBrush}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                      Visibility="{x:Bind IsActive, Mode=OneWay}">
            <Button Style="{StaticResource LumenSmallIconButtonStyle}" Background="{StaticResource LumenGlassDarkBrush}" Click="OnPauseResumeClicked" ToolTipService.ToolTip="Pause / resume">
              <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="{x:Bind PauseGlyph, Mode=OneWay}" FontSize="12" />
            </Button>
            <Button Style="{StaticResource LumenSmallIconButtonStyle}" Background="{StaticResource LumenGlassDarkBrush}" Click="OnMuteClicked" ToolTipService.ToolTip="Mute / unmute">
              <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="{x:Bind MuteGlyph, Mode=OneWay}" FontSize="12" />
            </Button>
          </StackPanel>
          <Grid x:Name="HoverLayer" Opacity="0">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.18" /></Grid.OpacityTransition>
            <Border CornerRadius="22" Background="#66050A12" BorderBrush="{StaticResource LumenAccentRimBrush}" BorderThickness="1" />
            <Button Style="{StaticResource LumenPrimaryButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="22" Height="44" Padding="22,0"
                    Tag="{x:Bind}" Click="OnApplyButtonClicked">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE768;" FontSize="13" />
                <TextBlock Text="Set as wallpaper" />
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </DataTemplate>

      <!-- ============================ small pieces ============================ -->
      <DataTemplate x:Key="CategoryChipTemplate" x:DataType="cat:CatalogCategory">
        <ToggleButton Style="{StaticResource LumenChipStyle}" Click="OnCategoryChipClicked" Tag="{x:Bind Id}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="{x:Bind IconGlyph}" FontSize="13" />
            <TextBlock Text="{x:Bind DisplayName}" />
          </StackPanel>
        </ToggleButton>
      </DataTemplate>

      <DataTemplate x:Key="TagPillTemplate" x:DataType="x:String">
        <Button Style="{StaticResource LumenGhostButtonStyle}" MinHeight="30" Height="30" Padding="12,0" CornerRadius="15" FontWeight="Medium" FontSize="12"
                Background="{StaticResource LumenSectionBrush}" Tag="{x:Bind}" Click="OnTagPillClicked">
          <TextBlock>
            <Run Text="#" Foreground="{StaticResource LumenMintTextBrush}" /><Run Text="{x:Bind}" />
          </TextBlock>
        </Button>
      </DataTemplate>

    </Grid.Resources>

    <!-- ============================ ambient light ============================ -->
    <Grid x:Name="AmbientBlueHost" Width="820" Height="820" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-330,-260,0" IsHitTestVisible="False" />
    <Grid x:Name="AmbientVioletHost" Width="1000" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-420,-480" IsHitTestVisible="False" />
    <Grid x:Name="AmbientMintHost" Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-460,0,0,-540" IsHitTestVisible="False" />
    <!-- the mint glow that sits beside the logo and fades with distance -->
    <Grid x:Name="HeaderGlowHost" Width="820" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-330,-124,0,0" IsHitTestVisible="False" />

    <Grid x:Name="ShellGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="72" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ================================ HEADER (transparent) ================================ -->
      <Grid x:Name="HeaderBar" Grid.Row="0" Padding="22,0,10,0">
        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource LumenHairlineBrush}" IsHitTestVisible="False" Margin="-22,0,-10,0" />
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="BrandPanel" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="13" Background="{StaticResource LumenGlassStrongBrush}" BorderBrush="{StaticResource LumenAccentRimBrush}" BorderThickness="1">
            <Image Source="ms-appx:///Assets/lumen-logo.png" Width="26" Height="26" Stretch="Uniform" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="Lumen" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource LumenTextBrush}" />
            <TextBlock Text="LIVE WALLPAPERS" Style="{StaticResource LumenEyebrowTextStyle}" FontSize="9" />
          </StackPanel>
        </StackPanel>

        <Border x:Name="NavPill" Grid.Column="1" Margin="34,0,0,0" Style="{StaticResource LumenGlassPanelStyle}" CornerRadius="17" Padding="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="NavExploreButton" Style="{StaticResource LumenSegmentStyle}" Click="OnNavExploreClicked">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE774;" FontSize="14" /><TextBlock Text="Explore" /></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="NavLibraryButton" Style="{StaticResource LumenSegmentStyle}" Click="OnNavLibraryClicked">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE8F1;" FontSize="14" /><TextBlock Text="Library" /></StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>

        <Grid x:Name="DragRegion" Grid.Column="2" Background="Transparent" />

        <StackPanel x:Name="HeaderActions" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button x:Name="ImportButton" Style="{StaticResource LumenButtonStyle}" Click="OnImportButtonClicked" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Import" /></StackPanel>
          </Button>
          <Button x:Name="RefreshButton" Style="{StaticResource LumenIconButtonStyle}" Click="OnRefreshClicked" ToolTipService.ToolTip="Refresh"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE72C;" FontSize="15" /></Button>
          <Button x:Name="SettingsButton" Style="{StaticResource LumenIconButtonStyle}" Click="OnSettingsClicked" ToolTipService.ToolTip="Settings"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE713;" FontSize="15" /></Button>
        </StackPanel>

        <Border x:Name="CaptionPanel" Grid.Column="4" Style="{StaticResource LumenGlassPanelStyle}" CornerRadius="16" Padding="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="MinimizeButton" Style="{StaticResource LumenCaptionButtonStyle}" Click="OnMinimizeClicked" ToolTipService.ToolTip="Minimize"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE921;" FontSize="10" /></Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource LumenCaptionButtonStyle}" Click="OnMaximizeClicked" ToolTipService.ToolTip="Maximize">
              <FontIcon x:Name="MaximizeGlyph" Style="{StaticResource LumenIconStyle}" Glyph="&#xE922;" FontSize="10" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource LumenCaptionCloseStyle}" Click="OnCloseClicked" ToolTipService.ToolTip="Close to tray"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE8BB;" FontSize="10" /></Button>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ================================ BODY ================================ -->
      <Grid x:Name="BodyGrid" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ContentHost" Grid.Column="0">

          <!-- EXPLORE -->
          <Grid x:Name="ExploreContentGrid" Margin="28,14,24,0" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border x:Name="SearchField" Style="{StaticResource LumenFieldStyle}" Height="48" CornerRadius="24" Padding="18,0,10,0">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE721;" FontSize="15" Foreground="{StaticResource LumenFaintTextBrush}" VerticalAlignment="Center"/>
                  <TextBox x:Name="ExploreSearchBox" Grid.Column="1" Style="{StaticResource LumenTextBoxStyle}" VerticalAlignment="Center"
                           PlaceholderText="Search wallpapers, moods, tags..." TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                  <Button x:Name="SearchClearButton" Grid.Column="2" Style="{StaticResource LumenSmallIconButtonStyle}" Background="Transparent" BorderThickness="0"
                          Click="OnSearchClearClicked" Visibility="Collapsed" VerticalAlignment="Center"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE711;" FontSize="11" /></Button>
                  <Border Grid.Column="3" Style="{StaticResource LumenBadgeStyle}" VerticalAlignment="Center" Background="#14FFFFFF">
                    <TextBlock Text="Ctrl K" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource LumenFaintTextBrush}" />
                  </Border>
                </Grid>
              </Border>
              <ToggleButton x:Name="FiltersToggleButton" Grid.Column="1" Style="{StaticResource LumenChipStyle}" MinHeight="48" Padding="20,0" CornerRadius="24" Click="OnFiltersToggleClicked">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE71C;" FontSize="14" />
                  <TextBlock Text="Filters" VerticalAlignment="Center" />
                  <Border x:Name="FilterCountBadge" Visibility="Collapsed" Background="{StaticResource LumenAccentBrush}" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0">
                    <TextBlock x:Name="FilterCountText" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LumenOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </StackPanel>
              </ToggleButton>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
              <ItemsRepeater x:Name="CategoryRepeater" ItemTemplate="{StaticResource CategoryChipTemplate}">
                <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="8" /></ItemsRepeater.Layout>
              </ItemsRepeater>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollViewer x:Name="TagsScroller" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="TRENDING" Style="{StaticResource LumenEyebrowTextStyle}" VerticalAlignment="Center" Margin="2,0,4,0" />
                  <ItemsRepeater x:Name="TagsRepeater" ItemTemplate="{StaticResource TagPillTemplate}">
                    <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="8" /></ItemsRepeater.Layout>
                  </ItemsRepeater>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="ExploreCountTextBlock" Style="{StaticResource LumenCaptionTextStyle}" VerticalAlignment="Center" />
                <Button x:Name="ClearFiltersLink" Style="{StaticResource LumenGhostButtonStyle}" MinHeight="28" Height="28" Padding="10,0" CornerRadius="14" FontSize="12"
                        Foreground="{StaticResource LumenMintTextBrush}" Click="OnClearFiltersClicked" Visibility="Collapsed" Content="Clear all" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
              <GridView x:Name="ExploreGridView" ItemTemplate="{StaticResource ExploreCardTemplate}" ItemContainerStyle="{StaticResource LumenCardItemStyle}"
                        SelectionMode="None" IsItemClickEnabled="False" Padding="0,4,0,120" ScrollViewer.VerticalScrollBarVisibility="Auto" />

              <StackPanel x:Name="ExploreLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="44" Height="44" />
                <TextBlock Text="Finding wallpapers..." Style="{StaticResource LumenCaptionTextStyle}" HorizontalAlignment="Center" />
              </StackPanel>

              <StackPanel x:Name="ExploreEmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed" MaxWidth="360">
                <Border Width="72" Height="72" CornerRadius="26" HorizontalAlignment="Center" Style="{StaticResource LumenGlassPanelStyle}">
                  <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE721;" FontSize="26" Foreground="{StaticResource LumenMintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Nothing matches yet" Style="{StaticResource LumenHeadingTextStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Try a different word, or loosen a few filters." Style="{StaticResource LumenBodyTextStyle}" TextAlignment="Center" HorizontalAlignment="Center" />
                <Button Style="{StaticResource LumenButtonStyle}" HorizontalAlignment="Center" Content="Reset everything" Click="OnClearFiltersClicked" />
              </StackPanel>

              <Border x:Name="PaginationPill" Style="{StaticResource LumenGlassStrongPanelStyle}" CornerRadius="18" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,22" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="PrevPageButton" Style="{StaticResource LumenSmallIconButtonStyle}" Background="Transparent" BorderThickness="0" Click="OnPrevPageClicked" ToolTipService.ToolTip="Previous page"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE76B;" FontSize="11" /></Button>
                  <TextBlock x:Name="PageSummaryTextBlock" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource LumenTextBrush}" VerticalAlignment="Center" MinWidth="42" TextAlignment="Center" />
                  <Button x:Name="NextPageButton" Style="{StaticResource LumenSmallIconButtonStyle}" Background="Transparent" BorderThickness="0" Click="OnNextPageClicked" ToolTipService.ToolTip="Next page"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE76C;" FontSize="11" /></Button>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- LIBRARY -->
          <Grid x:Name="LibraryContentGrid" Margin="28,14,28,0" RowSpacing="16" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock Text="Your library" Style="{StaticResource LumenTitleTextStyle}" />
                <TextBlock x:Name="LibrarySubtitleText" Style="{StaticResource LumenCaptionTextStyle}" FontSize="12" />
              </StackPanel>
              <Button x:Name="StorageButton" Grid.Column="1" Style="{StaticResource LumenButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xEDA2;" FontSize="14" /><TextBlock Text="Storage" /></StackPanel>
                <Button.Flyout>
                  <Flyout x:Name="StorageFlyout" Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource LumenFlyoutPresenterStyle}">
                    <StackPanel Width="320" Spacing="14" Padding="10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="STORAGE" Style="{StaticResource LumenEyebrowTextStyle}" />
                        <TextBlock x:Name="StorageUsageTextBlock" Style="{StaticResource LumenHeadingTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StorageRootTextBlock" Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                      </StackPanel>
                      <Rectangle Height="1" Fill="{StaticResource LumenDividerBrush}" />
                      <Button Style="{StaticResource LumenButtonStyle}" HorizontalAlignment="Stretch" Click="OnReconcileClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE895;" FontSize="13" /><TextBlock Text="Rescan library" /></StackPanel>
                      </Button>
                      <Button Style="{StaticResource LumenButtonStyle}" HorizontalAlignment="Stretch" Click="OnChangeStorageRootClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE8B7;" FontSize="13" /><TextBlock Text="Move library folder..." /></StackPanel>
                      </Button>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>

            <Grid Grid.Row="1" x:Name="LibraryDropZone" AllowDrop="True" Background="Transparent" DragOver="OnGridDragOver" Drop="OnGridDrop">
              <GridView x:Name="WallpaperGridView" ItemTemplate="{StaticResource LibraryCardTemplate}" ItemContainerStyle="{StaticResource LumenCardItemStyle}"
                        SelectionMode="None" IsItemClickEnabled="False" Padding="0,4,0,120" ScrollViewer.VerticalScrollBarVisibility="Auto" />

              <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="44" Height="44" />
                <TextBlock Text="Opening your library..." Style="{StaticResource LumenCaptionTextStyle}" HorizontalAlignment="Center" />
              </StackPanel>

              <Border x:Name="EmptyStatePanel" Style="{StaticResource LumenGlassPanelStyle}" CornerRadius="30" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="44,40" Visibility="Collapsed">
                <StackPanel Spacing="14" Width="330">
                  <Border Width="76" Height="76" CornerRadius="28" HorizontalAlignment="Center" Background="{StaticResource LumenAccentSoftBrush}" BorderBrush="{StaticResource LumenAccentRimBrush}" BorderThickness="1">
                    <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE8B9;" FontSize="28" Foreground="{StaticResource LumenMintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Nothing here yet" Style="{StaticResource LumenHeadingTextStyle}" HorizontalAlignment="Center" />
                  <TextBlock Text="Drop images or videos anywhere in this window, or grab something beautiful from Explore." Style="{StaticResource LumenBodyTextStyle}" TextAlignment="Center" />
                  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Style="{StaticResource LumenPrimaryButtonStyle}" Click="OnImportButtonClicked">
                      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Import files" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource LumenButtonStyle}" Content="Browse Explore" Click="OnNavExploreClicked" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>

        <!-- ============ ADVANCED FILTER DOCK: attached to the page edge, separate surface ============ -->
        <Grid x:Name="FilterDock" Grid.Column="1" Visibility="Collapsed" Width="392" Opacity="0">
          <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.22" /></Grid.OpacityTransition>
          <Grid.TranslationTransition><Vector3Transition Duration="0:0:0.3" /></Grid.TranslationTransition>
          <Border Style="{StaticResource LumenGlassStrongPanelStyle}" CornerRadius="28,0,0,0" BorderThickness="1,1,0,0" />
          <!-- seam light where the dock meets the page -->
          <Rectangle Width="2" HorizontalAlignment="Left" Margin="0,28,0,0" Fill="{StaticResource LumenAccentRimBrush}" Opacity="0.55" IsHitTestVisible="False" />
          <Grid Padding="22,20,22,18" RowSpacing="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock Text="ADVANCED" Style="{StaticResource LumenEyebrowTextStyle}" />
                <TextBlock Text="Filters" Style="{StaticResource LumenTitleTextStyle}" FontSize="24" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource LumenSmallIconButtonStyle}" VerticalAlignment="Top" Click="OnFiltersToggleClicked" ToolTipService.ToolTip="Close filters"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE711;" FontSize="12" /></Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource LumenGlassPanelStyle}" CornerRadius="15" Padding="4">
              <Grid ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="FilterTabBasics" Grid.Column="0" Style="{StaticResource LumenTabStyle}" HorizontalAlignment="Stretch" Tag="Basics" Click="OnFilterTabClicked" Content="Basics" />
                <ToggleButton x:Name="FilterTabQuality" Grid.Column="1" Style="{StaticResource LumenTabStyle}" HorizontalAlignment="Stretch" Tag="Quality" Click="OnFilterTabClicked" Content="Quality" />
                <ToggleButton x:Name="FilterTabLength" Grid.Column="2" Style="{StaticResource LumenTabStyle}" HorizontalAlignment="Stretch" Tag="Length" Click="OnFilterTabClicked" Content="Length" />
                <ToggleButton x:Name="FilterTabTags" Grid.Column="3" Style="{StaticResource LumenTabStyle}" HorizontalAlignment="Stretch" Tag="Tags" Click="OnFilterTabClicked" Content="Tags" />
              </Grid>
            </Border>

            <Grid Grid.Row="2">
              <ScrollViewer x:Name="FilterBasicsSection" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel Spacing="12">
                  <Border Style="{StaticResource LumenSectionStyle}">
            <StackPanel Spacing="12">
              <TextBlock Text="Wallpaper type" Style="{StaticResource LumenLabelTextStyle}" />
              <TextBlock Text="Moving scenes or still pictures." Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" />
              <ItemsRepeater x:Name="TypeRepeater">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="100" MinItemHeight="38" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Style="{StaticResource LumenChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="38">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                  </ToggleButton>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </Border>
                  <Border Style="{StaticResource LumenSectionStyle}">
            <StackPanel Spacing="12">
              <TextBlock Text="Sort by" Style="{StaticResource LumenLabelTextStyle}" />
              <TextBlock Text="How the results are ordered." Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" />
              <ItemsRepeater x:Name="SortRepeater">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinItemHeight="38" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Style="{StaticResource LumenChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="38">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                  </ToggleButton>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </Border>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer x:Name="FilterQualitySection" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                <StackPanel Spacing="12">
                  <Border Style="{StaticResource LumenSectionStyle}">
            <StackPanel Spacing="12">
              <TextBlock Text="Resolution" Style="{StaticResource LumenLabelTextStyle}" />
              <TextBlock Text="Smallest size you want to see." Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" />
              <ItemsRepeater x:Name="ResolutionRepeater">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinItemHeight="38" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Style="{StaticResource LumenChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="38">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                  </ToggleButton>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </Border>
                  <Border Style="{StaticResource LumenSectionStyle}">
            <StackPanel Spacing="12">
              <TextBlock Text="Shape" Style="{StaticResource LumenLabelTextStyle}" />
              <TextBlock Text="Match the proportions of your display." Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" />
              <ItemsRepeater x:Name="OrientationRepeater">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinItemHeight="38" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Style="{StaticResource LumenChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="38">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                  </ToggleButton>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </Border>
                  <Border Style="{StaticResource LumenSectionStyle}">
                    <StackPanel Spacing="10">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Minimum rating" Style="{StaticResource LumenLabelTextStyle}" />
                        <TextBlock x:Name="MinRatingText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource LumenMintTextBrush}" />
                      </Grid>
                      <Slider x:Name="MinRatingSlider" Minimum="0" Maximum="5" StepFrequency="0.5" SmallChange="0.5" ValueChanged="OnMinRatingChanged" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer x:Name="FilterLengthSection" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                <StackPanel Spacing="12">
                  <Border Style="{StaticResource LumenSectionStyle}">
            <StackPanel Spacing="12">
              <TextBlock Text="Video length" Style="{StaticResource LumenLabelTextStyle}" />
              <TextBlock Text="Only affects videos. Pictures are always shown." Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" />
              <ItemsRepeater x:Name="DurationRepeater">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinItemHeight="38" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Style="{StaticResource LumenChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="38">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                  </ToggleButton>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </Border>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer x:Name="FilterTagsSection" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                <StackPanel Spacing="12">
                  <Border Style="{StaticResource LumenSectionStyle}">
                    <StackPanel Spacing="12">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                          <TextBlock Text="Tags" Style="{StaticResource LumenLabelTextStyle}" />
                          <TextBlock x:Name="TagsHintText" Text="Pick several. A wallpaper must carry every tag you choose." Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource LumenGhostButtonStyle}" MinHeight="28" Height="28" Padding="10,0" CornerRadius="14" FontSize="12"
                                Foreground="{StaticResource LumenMintTextBrush}" Content="Clear" Click="OnClearTagsClicked" VerticalAlignment="Top" />
                      </Grid>
                      <ItemsRepeater x:Name="TagFilterRepeater">
                        <ItemsRepeater.Layout>
                          <UniformGridLayout MinItemWidth="104" MinItemHeight="36" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate x:DataType="vm:FilterChip">
                            <ToggleButton Style="{StaticResource LumenChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="36" Padding="8,0">
                              <TextBlock TextTrimming="CharacterEllipsis"><Run Text="#" Foreground="{StaticResource LumenMintTextBrush}" /><Run Text="{x:Bind Label}" /></TextBlock>
                            </ToggleButton>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FilterSummaryText" Style="{StaticResource LumenCaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="1" Style="{StaticResource LumenButtonStyle}" Content="Reset" Click="OnResetFiltersClicked" />
              <Button Grid.Column="2" Style="{StaticResource LumenPrimaryButtonStyle}" Content="Done" Click="OnFiltersToggleClicked" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- ============================ NOW PLAYING DOCK ============================ -->
    <Border x:Name="NowPlayingPanel" Style="{StaticResource LumenGlassStrongPanelStyle}" CornerRadius="26" Padding="14,10,10,10"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,22" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Border Width="40" Height="40" CornerRadius="15" Background="{StaticResource LumenAccentSoftBrush}" BorderBrush="{StaticResource LumenAccentRimBrush}" BorderThickness="1" VerticalAlignment="Center">
          <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE93E;" FontSize="16" Foreground="{StaticResource LumenMintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="0" MinWidth="120" MaxWidth="240">
          <TextBlock Text="NOW PLAYING" Style="{StaticResource LumenEyebrowTextStyle}" FontSize="9" />
          <TextBlock x:Name="NowPlayingTitleTextBlock" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource LumenTextBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="PauseResumeButton" Style="{StaticResource LumenIconButtonStyle}" Width="38" Height="38" MinHeight="38" CornerRadius="19" Click="OnPauseResumeClicked">
            <FontIcon x:Name="NowPlayingPauseIcon" Style="{StaticResource LumenIconStyle}" Glyph="&#xE769;" FontSize="14" />
          </Button>
          <Button Style="{StaticResource LumenIconButtonStyle}" Width="38" Height="38" MinHeight="38" CornerRadius="19" Click="OnMuteClicked" ToolTipService.ToolTip="Mute / unmute">
            <FontIcon x:Name="NowPlayingMuteIcon" Style="{StaticResource LumenIconStyle}" Glyph="&#xE767;" FontSize="14" />
          </Button>
          <Button Style="{StaticResource LumenIconButtonStyle}" Width="38" Height="38" MinHeight="38" CornerRadius="19" Click="OnStopClicked" ToolTipService.ToolTip="Stop and restore the normal wallpaper"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE71A;" FontSize="13" /></Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ============================ TOAST ============================ -->
    <Border x:Name="ToastHost" Style="{StaticResource LumenGlassStrongPanelStyle}" CornerRadius="20" Padding="16,12,10,12"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Opacity="0" Visibility="Collapsed" MaxWidth="560">
      <Border.OpacityTransition><ScalarTransition Duration="0:0:0.22" /></Border.OpacityTransition>
      <Border.TranslationTransition><Vector3Transition Duration="0:0:0.28" /></Border.TranslationTransition>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border x:Name="ToastIconHost" Width="30" Height="30" CornerRadius="11" Background="{StaticResource LumenAccentSoftBrush}" VerticalAlignment="Center">
          <FontIcon x:Name="ToastIcon" Style="{StaticResource LumenIconStyle}" Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource LumenMintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="ToastText" FontSize="13" Foreground="{StaticResource LumenTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
        <Button Style="{StaticResource LumenSmallIconButtonStyle}" Background="Transparent" BorderThickness="0" Click="OnToastCloseClicked" VerticalAlignment="Center"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE711;" FontSize="11" /></Button>
      </StackPanel>
    </Border>

    <!-- ============================ DETAILS DIALOG ============================ -->
    <Grid x:Name="DetailsOverlay" Visibility="Collapsed" Opacity="0">
      <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Grid.OpacityTransition>
      <Rectangle Fill="{StaticResource LumenScrimBrush}" Tapped="OnDetailsBackdropTapped" />
      <Border x:Name="DetailsPanel" Style="{StaticResource LumenGlassStrongPanelStyle}" CornerRadius="30" Width="940" Height="540"
              HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="OnDialogPanelTapped">
        <Border.TranslationTransition><Vector3Transition Duration="0:0:0.3" /></Border.TranslationTransition>
        <Grid ColumnSpacing="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Margin="16" CornerRadius="22" BorderBrush="{StaticResource LumenRimBrush}" BorderThickness="1">
            <Border.Background>
              <ImageBrush x:Name="DetailsPreviewBrush" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <Grid Grid.Column="1" Padding="10,26,26,24" RowSpacing="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock x:Name="DetailsCategoryTextBlock" Style="{StaticResource LumenEyebrowTextStyle}" />
                <TextBlock x:Name="DetailsTitleTextBlock" Style="{StaticResource LumenTitleTextStyle}" FontSize="25" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailsAuthorTextBlock" Style="{StaticResource LumenCaptionTextStyle}" FontSize="12" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource LumenSmallIconButtonStyle}" VerticalAlignment="Top" Click="OnCloseDetailsClicked"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE711;" FontSize="12" /></Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
              <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Style="{StaticResource LumenBadgeStyle}" Background="#14FFFFFF"><TextBlock x:Name="DetailsResolutionText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LumenTextBrush}" /></Border>
                  <Border Style="{StaticResource LumenBadgeStyle}" Background="#14FFFFFF"><TextBlock x:Name="DetailsSizeText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LumenTextBrush}" /></Border>
                  <Border Style="{StaticResource LumenBadgeStyle}" Background="#14FFFFFF"><TextBlock x:Name="DetailsAspectText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LumenTextBrush}" /></Border>
                </StackPanel>
                <TextBlock x:Name="DetailsStatsTextBlock" FontSize="12" Foreground="{StaticResource LumenMintTextBrush}" />
                <TextBlock x:Name="DetailsDescriptionTextBlock" Style="{StaticResource LumenBodyTextStyle}" />
                <ItemsRepeater x:Name="DetailsTagsRepeater">
                  <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="92" MinItemHeight="30" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Background="{StaticResource LumenSectionBrush}" BorderBrush="{StaticResource LumenRimSoftBrush}" BorderThickness="1" CornerRadius="15" Height="30" Padding="10,0">
                        <TextBlock Text="{x:Bind}" FontSize="12" Foreground="{StaticResource LumenMutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Border>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Spacing="10">
              <ProgressBar x:Name="DetailsProgressBar" Minimum="0" Maximum="100" Height="4" Visibility="Collapsed" />
              <Button x:Name="DetailsPrimaryButton" Style="{StaticResource LumenPrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="48" CornerRadius="16" FontSize="14" Click="OnDetailsPrimaryClicked" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ============================ DOWNLOAD SHEET ============================ -->
    <Grid x:Name="DownloadOverlay" Visibility="Collapsed" Opacity="0">
      <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Grid.OpacityTransition>
      <Rectangle Fill="{StaticResource LumenScrimBrush}" Tapped="OnDownloadBackdropTapped" />
      <Border x:Name="DownloadPanel" Style="{StaticResource LumenGlassStrongPanelStyle}" CornerRadius="30" Width="440" Padding="18"
              HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="OnDialogPanelTapped">
        <Border.TranslationTransition><Vector3Transition Duration="0:0:0.3" /></Border.TranslationTransition>
        <StackPanel Spacing="16">
          <Border Height="190" CornerRadius="22" BorderBrush="{StaticResource LumenRimBrush}" BorderThickness="1">
            <Border.Background>
              <ImageBrush x:Name="DownloadPreviewBrush" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <StackPanel Spacing="4" Margin="6,0">
            <TextBlock x:Name="DownloadHeadlineText" Style="{StaticResource LumenEyebrowTextStyle}" />
            <TextBlock x:Name="DownloadTitleText" Style="{StaticResource LumenTitleTextStyle}" FontSize="22" TextWrapping="Wrap" />
            <TextBlock x:Name="DownloadSpecsText" Style="{StaticResource LumenCaptionTextStyle}" FontSize="12" />
          </StackPanel>
          <Border Style="{StaticResource LumenSectionStyle}" Padding="14,12" Margin="0">
            <StackPanel Spacing="10">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource LumenMintTextBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Saved to your library" Style="{StaticResource LumenLabelTextStyle}" />
                  <TextBlock x:Name="DownloadLocationText" Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Height="4" Visibility="Collapsed" />
              <TextBlock x:Name="DownloadStateText" Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
          </Border>
          <Grid ColumnSpacing="10" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DownloadSecondaryButton" Grid.Column="0" Style="{StaticResource LumenButtonStyle}" HorizontalAlignment="Stretch" Height="46" CornerRadius="16" Content="Not now" Click="OnDownloadSecondaryClicked" />
            <Button x:Name="DownloadPrimaryButton" Grid.Column="1" Style="{StaticResource LumenPrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="46" CornerRadius="16" Content="Download" Click="OnDownloadPrimaryClicked" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============================ SETTINGS SHEET ============================ -->
    <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Opacity="0">
      <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Grid.OpacityTransition>
      <Rectangle Fill="{StaticResource LumenScrimBrush}" Tapped="OnSettingsBackdropTapped" />
      <Border x:Name="SettingsPanel" Style="{StaticResource LumenGlassStrongPanelStyle}" CornerRadius="30" Width="520"
              HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,18,18,18" Tapped="OnDialogPanelTapped">
        <Border.TranslationTransition><Vector3Transition Duration="0:0:0.32" /></Border.TranslationTransition>
        <Grid Padding="24,22,24,20" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
              <TextBlock Text="PREFERENCES" Style="{StaticResource LumenEyebrowTextStyle}" />
              <TextBlock Text="Settings" Style="{StaticResource LumenTitleTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource LumenSmallIconButtonStyle}" VerticalAlignment="Top" Click="OnCloseSettingsClicked"><FontIcon Style="{StaticResource LumenIconStyle}" Glyph="&#xE711;" FontSize="12" /></Button>
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource LumenGlassPanelStyle}" CornerRadius="15" Padding="4">
            <Grid ColumnSpacing="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <ToggleButton x:Name="SettingsTabGeneral" Grid.Column="0" Style="{StaticResource LumenTabStyle}" HorizontalAlignment="Stretch" Tag="General" Click="OnSettingsTabClicked" Content="General" />
              <ToggleButton x:Name="SettingsTabPlayback" Grid.Column="1" Style="{StaticResource LumenTabStyle}" HorizontalAlignment="Stretch" Tag="Playback" Click="OnSettingsTabClicked" Content="Playback" />
              <ToggleButton x:Name="SettingsTabPerformance" Grid.Column="2" Style="{StaticResource LumenTabStyle}" HorizontalAlignment="Stretch" Tag="Performance" Click="OnSettingsTabClicked" Content="Performance" />
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <ScrollViewer x:Name="SettingsGeneralSection" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
              <StackPanel Spacing="14">
                <Border Style="{StaticResource LumenSectionStyle}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Your name" Style="{StaticResource LumenLabelTextStyle}" />
                    <Border Style="{StaticResource LumenFieldStyle}" Height="44">
                      <TextBox x:Name="SettingsDisplayNameTextBox" Style="{StaticResource LumenTextBoxStyle}" VerticalAlignment="Center" PlaceholderText="How should Lumen call you?" TextChanged="OnSettingsDisplayNameChanged" />
                    </Border>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource LumenSectionStyle}">
          <StackPanel Spacing="12">
            <Grid ColumnSpacing="16" MinHeight="48">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Launch with Windows" Style="{StaticResource LumenLabelTextStyle}" />
                <TextBlock Text="Start Lumen quietly when you sign in." Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleButton x:Name="SettingsStartWithWindowsToggle" Grid.Column="1" Style="{StaticResource LumenSwitchStyle}" Click="OnSettingsToggleClicked" />
            </Grid>
            <Rectangle Height="1" Fill="{StaticResource LumenDividerBrush}" />
            <Grid ColumnSpacing="16" MinHeight="48">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Start in the tray" Style="{StaticResource LumenLabelTextStyle}" />
                <TextBlock Text="Skip the window and stay in the system tray." Style="{StaticResource LumenCaptionTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleButton x:Name="SettingsStartMinimizedToggle" Grid.Column="1" Style="{StaticResource LumenSwitchStyle}" Click="OnSettingsToggleClicked" />
            </Grid>
          </StackPanel>
        </Border>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPlaybackSection" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Visibility="Collapsed">
              <StackPanel Spacing="14">
                <Border Style="{StaticResource LumenSectionStyle}">
                  <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Picture fit" Style="{StaticResource LumenLabelTextStyle}" />
                      <TextBlock Text="How a wallpaper fills your screen." Style="{StaticResource LumenCaptionTextStyle}" />
                    </StackPanel>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
