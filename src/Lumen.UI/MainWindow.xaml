                      <ToggleButton x:Name="ScaleFitChip" Grid.Row="0" Grid.Column="1" Style="{StaticResource LumenChipStyle}" HorizontalAlignment="Stretch" Tag="Fit" Content="Fit" Click="OnScalingChipClicked" />
