<Window
    x:Class="Lumen.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Lumen.UI.ViewModels"
    xmlns:cat="using:Lumen.Core.Models.Catalog"
    mc:Ignorable="d"
    Title="Lumen — Live Wallpaper Platform">

    <Grid x:ConnectionId='2' x:Name="RootGrid" Background="{ThemeResource LumenPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <!-- ========================= CUSTOM TITLE BAR ========================= -->
        <Grid x:ConnectionId='3' x:Name="AppTitleBar"
              Grid.Row="0"
              Background="{ThemeResource LumenTitleBarBrush}"
              Padding="18,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="11" Background="#14000000" Padding="2">
                    <Image Source="ms-appx:///Assets/lumen-logo.png" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="-1">
                    <TextBlock Text="Lumen"
                               Style="{StaticResource LumenHeadingStyle}"
                               FontSize="18" />
                    <TextBlock Text="Live wallpapers, without the clutter"
                               Style="{StaticResource LumenMutedStyle}"
                               FontSize="10.5" />
                </StackPanel>
            </StackPanel>


        </Grid>

        <!-- ========================= APP TOOLBAR / NAV ========================= -->
        <Grid Grid.Row="1" Padding="18,10">
            <Border Background="{ThemeResource LumenSurfaceBrush}"
                    BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Segmented navigation -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource LumenChipBrush}"
                            CornerRadius="17"
                            Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button x:ConnectionId='111' x:Name="NavExploreButton"
                                    Style="{StaticResource LumenNavButtonStyle}"
                                                               >
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71E;" FontSize="14" />
                                    <TextBlock Text="Explore" />
                                </StackPanel>
                            </Button>
                            <Button x:ConnectionId='112' x:Name="NavLibraryButton"
                                    Style="{StaticResource LumenNavButtonStyle}"
                                                               >
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                    <TextBlock Text="Library" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="Discover. Collect. Set the mood."
                               Style="{StaticResource LumenMutedStyle}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />

                    <!-- Compact actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
                        <Button x:ConnectionId='106' x:Name="ImportButton"
                                Style="{StaticResource LumenAccentButtonStyle}"
                                                             >
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='107' x:Name="RefreshButton"
                                Style="{StaticResource LumenIconButtonStyle}"
                                                        >
                            <FontIcon Glyph="&#xE777;" FontSize="15" />
                            <ToolTipService.ToolTip>Refresh</ToolTipService.ToolTip>
                        </Button>

                        <Button x:ConnectionId='108' x:Name="PauseResumeButton"
                                Style="{StaticResource LumenIconButtonStyle}"
                                                            >
                            <FontIcon x:ConnectionId='110' x:Name="PauseResumeIcon" Glyph="&#xE769;" FontSize="15" />
                            <ToolTipService.ToolTip>Pause / Resume wallpapers</ToolTipService.ToolTip>
                        </Button>

                        <Button x:ConnectionId='109' x:Name="SettingsButton"
                                Style="{StaticResource LumenIconButtonStyle}"
                                                         >
                            <FontIcon Glyph="&#xE713;" FontSize="15" />
                            <ToolTipService.ToolTip>Settings</ToolTipService.ToolTip>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================= MAIN CONTENT ========================= -->
        <Grid Grid.Row="2">
            <InfoBar x:ConnectionId='6' x:Name="ErrorNotificationBar"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="True"
                     VerticalAlignment="Top"
                     Margin="20,4,20,0"
                     Canvas.ZIndex="30" />

            <!-- Ambient background accent -->
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="380"
                    Height="230"
                    Margin="-80,-60,0,0"
                    CornerRadius="160"
                    Background="#223AD9FF"
                    Opacity="0.35" />
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="320"
                    Height="220"
                    Margin="0,0,-90,-80"
                    CornerRadius="150"
                    Background="#26D54CFF"
                    Opacity="0.22" />

            <!-- ========================= EXPLORE ========================= -->
            <Grid x:ConnectionId='7' x:Name="ExploreContentGrid" Padding="20,6,20,10" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hero search surface -->
                <Border Grid.Row="0"
                        Background="{ThemeResource LumenSurfaceBrush}"
                        BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="18,14"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Find your next atmosphere"
                                       Style="{StaticResource LumenHeadingStyle}"
                                       FontSize="19" />
                            <TextBlock Text="Search by mood, creator, tag or category"
                                       Style="{StaticResource LumenMutedStyle}"
                                       FontSize="11" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="430"
                                Margin="20,0,8,0"
                                Background="{ThemeResource LumenSolidSurfaceBrush}"
                                BorderBrush="{ThemeResource LumenSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="11,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="10" Background="{ThemeResource LumenAccentSoftBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource LumenTextBrush}" />
                                </Border>
                                <TextBox x:ConnectionId='105' x:Name="ExploreSearchBox"
                                         Grid.Column="1"
                                         Style="{StaticResource LumenSearchTextBoxStyle}"
                                         PlaceholderText="Search by atmosphere, creator, tag…"
                                                                           />
                                <Border Grid.Column="2" Background="{ThemeResource LumenChipBrush}" BorderBrush="{ThemeResource LumenSubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,4" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl K" Style="{StaticResource LumenMutedStyle}" FontSize="9" />
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <!-- Categories + filters -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{ThemeResource LumenSurfaceBrush}"
                            BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="5,4"
                            Margin="0,0,8,0"
                            Height="44">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="620">
                            <ItemsControl x:ConnectionId='102' x:Name="CategoryPillsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                 >
                                    <Button x:ConnectionId='104'                               
                                                             
                                            Style="{StaticResource LumenPillStyle}"
                                            Margin="2"
                                                                          />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top">
                        <Button x:ConnectionId='84' x:Name="TypeFilterButton" Style="{StaticResource LumenFilterButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE81E;" FontSize="13" />
                                <TextBlock x:ConnectionId='98' x:Name="TypeFilterLabel" Text="All types" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:ConnectionId='99' Text="All types" Tag="0"                                 />
                                    <MenuFlyoutItem x:ConnectionId='100' Text="Videos" Tag="1"                                 />
                                    <MenuFlyoutItem x:ConnectionId='101' Text="Images" Tag="2"                                 />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:ConnectionId='85' x:Name="ResolutionFilterButton" Style="{StaticResource LumenFilterButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE91B;" FontSize="13" />
                                <TextBlock x:ConnectionId='93' x:Name="ResolutionFilterLabel" Text="All sizes" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:ConnectionId='94' Text="All sizes" Tag="0"                                       />
                                    <MenuFlyoutItem x:ConnectionId='95' Text="1080p FHD" Tag="1"                                       />
                                    <MenuFlyoutItem x:ConnectionId='96' Text="1440p QHD" Tag="2"                                       />
                                    <MenuFlyoutItem x:ConnectionId='97' Text="4K UHD" Tag="3"                                       />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:ConnectionId='86' x:Name="SortFilterButton" Style="{StaticResource LumenFilterButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                                <TextBlock x:ConnectionId='87' x:Name="SortFilterLabel" Text="Relevance" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:ConnectionId='88' Text="Relevance" Tag="0"                                 />
                                    <MenuFlyoutItem x:ConnectionId='89' Text="Most popular" Tag="1"                                 />
                                    <MenuFlyoutItem x:ConnectionId='90' Text="Newest" Tag="2"                                 />
                                    <MenuFlyoutItem x:ConnectionId='91' Text="Top rated" Tag="3"                                 />
                                    <MenuFlyoutItem x:ConnectionId='92' Text="Title A–Z" Tag="4"                                 />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Results -->
                <Grid Grid.Row="2">
                    <StackPanel x:ConnectionId='70' x:Name="ExploreLoadingPanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                Visibility="Collapsed">
                        <ProgressRing IsActive="True" Width="42" Height="42" />
                        <TextBlock Text="Curating your wallpapers..." Style="{StaticResource LumenMutedStyle}" />
                    </StackPanel>

                    <StackPanel x:ConnectionId='71' x:Name="ExploreEmptyStatePanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="420"
                                Spacing="12"
                                Visibility="Collapsed">
                        <Border Width="84" Height="84" CornerRadius="30" Background="{StaticResource LumenAccentGradientBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="✦" Foreground="White" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nothing matched that vibe"
                                   Style="{StaticResource LumenHeadingStyle}"
                                   FontSize="23"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Try another keyword or clear the filters and explore a little wider."
                                   Style="{StaticResource LumenMutedStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button x:ConnectionId='83' Content="Reset filters"
                                Style="{StaticResource LumenAccentButtonStyle}"
                                                             
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <GridView x:ConnectionId='72' x:Name="ExploreGridView"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                                                              
                              Padding="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate                                     >
                                <Border x:ConnectionId='74' Width="292"
                                        Height="270"
                                        Margin="4"
                                        CornerRadius="22"
                                        Background="{ThemeResource LumenSurfaceBrush}"
                                        BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                                        BorderThickness="1"
                                                                    >
                                    <Grid>
                                        <Border CornerRadius="23" Background="{StaticResource LumenAmbientGradientBrush}" />
                                        <Image x:ConnectionId='75'                                  
                                               Stretch="UniformToFill"
                                               Opacity="0.96" />
                                        <Rectangle Fill="#B80B1020" />
                                        <Border VerticalAlignment="Top"
                                                HorizontalAlignment="Left"
                                                Margin="12"
                                                Background="#CCFFFFFF"
                                                CornerRadius="11"
                                                Padding="8,5">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="★" FontSize="11" Foreground="#B67A00" />
                                                <TextBlock x:ConnectionId='82'                            FontSize="10" Foreground="#303747" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border VerticalAlignment="Top"
                                                HorizontalAlignment="Right"
                                                Margin="12"
                                                Background="#3A0B1415"
                                                CornerRadius="11"
                                                Padding="8,5">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="White" />
                                                <TextBlock x:ConnectionId='81'                               FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>

                                        <Border VerticalAlignment="Bottom"
                                                Margin="10"
                                                Padding="15"
                                                CornerRadius="18"
                                                Background="#D90B1020"
                                                BorderBrush="#42FFFFFF"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock x:ConnectionId='76'                      
                                                           Grid.Row="0"
                                                           Foreground="White"
                                                           FontFamily="Segoe UI Variable Display"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:ConnectionId='77'                       
                                                           Grid.Row="1"
                                                           Foreground="#D9E3F1"
                                                           FontSize="11"
                                                           Margin="0,2,0,0" />
                                                <Grid Grid.Row="2" Margin="0,9,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <TextBlock x:ConnectionId='79'                                Foreground="#C5D2DC" FontSize="10" />
                                                        <TextBlock Text="•" Foreground="#7F928C" FontSize="10" />
                                                        <TextBlock x:ConnectionId='80'                               Foreground="#C5D2DC" FontSize="10" />
                                                    </StackPanel>
                                                    <Button x:ConnectionId='78' Grid.Column="1"
                                                                          
                                                                                             
                                                            Style="{StaticResource LumenAccentButtonStyle}"
                                                            Padding="12,7"
                                                                                                />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <Border Grid.Row="3"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource LumenSurfaceBrush}"
                        BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="5">
                    <Grid MinWidth="190" MaxWidth="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:ConnectionId='67' x:Name="PrevPageButton" Width="30" Height="28" Padding="0" Content="‹" Style="{StaticResource LumenGlassButtonStyle}"                           />
                        <TextBlock x:ConnectionId='68' x:Name="PageSummaryTextBlock" Grid.Column="1" Style="{StaticResource LumenMutedStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" />
                        <Button x:ConnectionId='69' x:Name="NextPageButton" Grid.Column="2" Width="30" Height="28" Padding="0" Content="›" Style="{StaticResource LumenGlassButtonStyle}"                           />
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================= LIBRARY ========================= -->
            <Grid x:ConnectionId='8' x:Name="LibraryContentGrid"
                  Visibility="Collapsed"
                  Padding="20,6,20,10"
                  AllowDrop="True"
                                           
                                   >

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{ThemeResource LumenSurfaceBrush}"
                        BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="18,13"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="Your collection"
                                       Style="{StaticResource LumenHeadingStyle}"
                                       FontSize="20" />
                            <TextBlock Text="Big visuals first. Everything else stays out of the way."
                                       Style="{StaticResource LumenMutedStyle}"
                                       FontSize="11" />
                        </StackPanel>
                        <Button x:ConnectionId='60' x:Name="StorageButton"
                                Grid.Column="1"
                                Style="{StaticResource LumenGlassButtonStyle}"
                                Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                                <TextBlock Text="Storage" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:ConnectionId='62' x:Name="StorageFlyout">
                                    <StackPanel Spacing="10" Width="330" Padding="8">
                                        <TextBlock Text="Storage management" Style="{StaticResource LumenHeadingStyle}" FontSize="17" />
                                        <TextBlock x:ConnectionId='63' x:Name="StorageRootTextBlock" TextWrapping="Wrap" Style="{StaticResource LumenMutedStyle}" FontSize="11" />
                                        <TextBlock x:ConnectionId='64' x:Name="StorageUsageTextBlock" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" />
                                        <MenuFlyoutSeparator />
                                        <Button x:ConnectionId='65' x:Name="ReconcileButton" Content="Reconcile &amp; rebuild library" HorizontalAlignment="Stretch"                            />
                                        <Button x:ConnectionId='66' x:Name="ChangeStorageRootButton" Content="Change storage root…" HorizontalAlignment="Stretch"                                    />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:ConnectionId='61' Grid.Column="2"
                                Style="{StaticResource LumenAccentButtonStyle}"
                                Margin="8,0,0,0"
                                                             >
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add wallpaper" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel x:ConnectionId='49' x:Name="LoadingPanel"
                            Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="44" Height="44" />
                    <TextBlock Text="Loading your collection…" Style="{StaticResource LumenMutedStyle}" />
                </StackPanel>

                <StackPanel x:ConnectionId='50' x:Name="EmptyStatePanel"
                            Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="430"
                            Spacing="12"
                            Visibility="Collapsed">
                    <Border Width="100" Height="100" CornerRadius="34" Background="{StaticResource LumenAccentGradientBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="✦" Foreground="White" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Your library is still a blank canvas"
                               Style="{StaticResource LumenHeadingStyle}"
                               FontSize="24"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Drop a wallpaper here or pull one from Explore. Lumen will generate and reuse thumbnails so you can pick by sight, not by filename."
                               Style="{StaticResource LumenMutedStyle}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button x:ConnectionId='59' Content="Import wallpapers"
                            Style="{StaticResource LumenAccentButtonStyle}"
                            HorizontalAlignment="Center"
                                                          />
                </StackPanel>

                <GridView x:ConnectionId='51' x:Name="WallpaperGridView"
                          Grid.Row="1"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                                                            
                          Padding="2"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate                                       >
                            <Border x:ConnectionId='53' Width="350"
                                    Height="258"
                                    Margin="4"
                                    CornerRadius="23"
                                    Background="{ThemeResource LumenSurfaceBrush}"
                                    BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Border CornerRadius="25" Background="{StaticResource LumenAmbientGradientBrush}" />
                                    <Image x:ConnectionId='54'                                 Stretch="UniformToFill" Opacity="0.98" />
                                    <Rectangle Fill="#B80B1020" />

                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="12"
                                            Background="#AAFFFFFF"
                                            CornerRadius="11"
                                            Padding="9,5">
                                        <TextBlock x:ConnectionId='58'                          
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#20293A" />
                                    </Border>

                                    <Border VerticalAlignment="Bottom"
                                            Margin="10"
                                            Padding="16"
                                            CornerRadius="19"
                                            Background="#DF0B1020"
                                            BorderBrush="#45FFFFFF"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock x:ConnectionId='55'                      
                                                       Style="{StaticResource LumenHeadingStyle}"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid Grid.Row="1" Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:ConnectionId='56'                            
                                                           Foreground="#BDCADB"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button x:ConnectionId='57' Grid.Column="1"
                                                        Content="Set wallpaper"
                                                                      
                                                                                    
                                                        Style="{StaticResource LumenAccentButtonStyle}"
                                                        Padding="12,7" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- ========================= SETTINGS DRAWER ========================= -->
            <Grid x:ConnectionId='9' x:Name="SettingsOverlay"
                  Visibility="Collapsed"
                  Background="#3A0B1415"
                  Canvas.ZIndex="80">
                <Border x:ConnectionId='23' x:Name="SettingsPanel"
                        Width="520"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Margin="0,0,18,0"
                        CornerRadius="24"
                        Background="{ThemeResource LumenElevatedBrush}"
                        BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drawer header -->
                        <Grid Grid.Row="0" Padding="24,22,24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="38" Height="38" CornerRadius="13" Background="{StaticResource LumenAccentGradientBrush}">
                                        <FontIcon Glyph="&#xE713;" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Settings" Style="{StaticResource LumenHeadingStyle}" FontSize="24" />
                                        <TextBlock Text="Tune Lumen until it feels like yours."
                                                   Style="{StaticResource LumenMutedStyle}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Button x:ConnectionId='48' Grid.Column="1"
                                    Style="{StaticResource LumenIconButtonStyle}"
                                                                  >
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <ToolTipService.ToolTip>Close settings</ToolTipService.ToolTip>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="24,0,24,24" Spacing="13">
                                <!-- General -->
                                <Border Background="{ThemeResource LumenSurfaceBrush}" BorderBrush="{ThemeResource LumenGlassBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <TextBlock Text="◉" FontSize="16" Foreground="#35BFAE" />
                                            <StackPanel>
                                                <TextBlock Text="General" Style="{StaticResource LumenHeadingStyle}" FontSize="17" />
                                                <TextBlock Text="Identity and startup behavior" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="210" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Display name" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="Used for your local profile" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                                            </StackPanel>
                                            <TextBox x:ConnectionId='47' x:Name="SettingsDisplayNameTextBox" Grid.Column="1"                                            />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Start with Windows" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="Launch in the background when Windows starts" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='46' x:Name="SettingsStartWithWindowsToggle" Grid.Column="1"                                             />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Start minimized to tray" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="Stay quiet after sign-in" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='45' x:Name="SettingsStartMinimizedToggle" Grid.Column="1"                                           />
                                        </Grid>

                                        <Border Background="{ThemeResource LumenAccentSoftBrush}" CornerRadius="14" Padding="11,9">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Closing Lumen" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="The window closes to the system tray. Use the tray menu to exit Lumen completely." Style="{StaticResource LumenMutedStyle}" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Appearance -->
                                <Border Background="{ThemeResource LumenSurfaceBrush}" BorderBrush="{ThemeResource LumenGlassBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <TextBlock Text="✦" FontSize="18" Foreground="#D28A54" />
                                            <StackPanel>
                                                <TextBlock Text="Appearance" Style="{StaticResource LumenHeadingStyle}" FontSize="17" />
                                                <TextBlock Text="Choose the visual personality" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="190" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Theme" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="Light, dark or follow Windows" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                                            </StackPanel>
                                            <ComboBox x:ConnectionId='44' x:Name="SettingsThemeComboBox" Grid.Column="1" Style="{StaticResource LumenSettingsComboBoxStyle}"                                          >
                                                <ComboBoxItem Content="Light" />
                                                <ComboBoxItem Content="Dark" />
                                                <ComboBoxItem Content="System" />
                                            </ComboBox>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="190" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Wallpaper scaling" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="Default fit mode for newly applied wallpapers" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:ConnectionId='43' x:Name="SettingsScalingComboBox" Grid.Column="1" Style="{StaticResource LumenSettingsComboBoxStyle}"                                            >
                                                <ComboBoxItem Content="Fill" />
                                                <ComboBoxItem Content="Fit" />
                                                <ComboBoxItem Content="Stretch" />
                                                <ComboBoxItem Content="Center" />
                                                <ComboBoxItem Content="Span" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Playback -->
                                <Border Background="{ThemeResource LumenSurfaceBrush}" BorderBrush="{ThemeResource LumenGlassBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <TextBlock Text="▶" FontSize="16" Foreground="#E3A35E" />
                                            <StackPanel>
                                                <TextBlock Text="Playback" Style="{StaticResource LumenHeadingStyle}" FontSize="17" />
                                                <TextBlock Text="Smoothness versus resource usage" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="190" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Global target FPS" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="15–240 FPS" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                                            </StackPanel>
                                            <NumberBox x:ConnectionId='42' x:Name="SettingsFpsNumberBox"
                                                       Grid.Column="1"
                                                       Minimum="15"
                                                       Maximum="240"
                                                       SmallChange="5"
                                                       SpinButtonPlacementMode="Compact"
                                                                                           />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Playback defaults -->
                                <Border Background="{ThemeResource LumenSurfaceBrush}" BorderBrush="{ThemeResource LumenGlassBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <TextBlock Text="◒" FontSize="18" Foreground="#35C9B5" />
                                            <StackPanel>
                                                <TextBlock Text="Playback defaults" Style="{StaticResource LumenHeadingStyle}" FontSize="17" />
                                                <TextBlock Text="Fine-tune how new wallpapers behave" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2"><TextBlock Text="Default volume" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><TextBlock Text="Applied to new video wallpapers" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" /></StackPanel>
                                            <Slider x:ConnectionId='41' x:Name="SettingsDefaultVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5"                                               />
                                        </Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Start muted" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><ToggleSwitch x:ConnectionId='40' x:Name="SettingsDefaultMutedToggle" Grid.Column="1"                                         /></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="Playback speed" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><TextBlock Text="0.25× to 2×" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" /></StackPanel><NumberBox x:ConnectionId='39' x:Name="SettingsPlaybackSpeedNumberBox" Grid.Column="1" Minimum="0.25" Maximum="2" SmallChange="0.25" SpinButtonPlacementMode="Compact"                                               /></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="Loop wallpaper" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><TextBlock Text="Restart media when it reaches the end" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" /></StackPanel><ToggleSwitch x:ConnectionId='38' x:Name="SettingsLoopToggle" Grid.Column="1"                                 /></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Brightness" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><Slider x:ConnectionId='37' x:Name="SettingsBrightnessSlider" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="5"                                            /></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Contrast" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><Slider x:ConnectionId='36' x:Name="SettingsContrastSlider" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="5"                                          /></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Saturation" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><Slider x:ConnectionId='35' x:Name="SettingsSaturationSlider" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="5"                                            /></Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Performance -->
                                <Border Background="{ThemeResource LumenSurfaceBrush}" BorderBrush="{ThemeResource LumenGlassBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <TextBlock Text="◌" FontSize="19" Foreground="#56C89B" />
                                            <StackPanel>
                                                <TextBlock Text="Performance" Style="{StaticResource LumenHeadingStyle}" FontSize="17" />
                                                <TextBlock Text="Pause decoding when the desktop is covered" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Pause on fullscreen apps" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><ToggleSwitch x:ConnectionId='34' x:Name="SettingsPauseFullscreenToggle" Grid.Column="1"                                            /></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Pause on maximized windows" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><ToggleSwitch x:ConnectionId='33' x:Name="SettingsPauseMaximizedToggle" Grid.Column="1"                                           /></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Pause on battery" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><ToggleSwitch x:ConnectionId='32' x:Name="SettingsPauseBatteryToggle" Grid.Column="1"                                         /></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Pause when covered" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><ToggleSwitch x:ConnectionId='31' x:Name="SettingsPauseCoveredToggle" Grid.Column="1"                                         /></Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Covered threshold" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="Pause once this share of a monitor is hidden" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Slider x:ConnectionId='29' x:Name="SettingsCoverageSlider" Minimum="50" Maximum="100" StepFrequency="5" Width="170"                                          />
                                                <TextBlock x:ConnectionId='30' x:Name="SettingsCoverageValueTextBlock" Text="85%" Width="40" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Mute audio when covered" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><ToggleSwitch x:ConnectionId='28' x:Name="SettingsMuteCoveredToggle" Grid.Column="1"                                        /></Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2"><TextBlock Text="Performance check interval" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" /><TextBlock Text="250–5000 ms" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" /></StackPanel>
                                            <NumberBox x:ConnectionId='27' x:Name="SettingsHeartbeatNumberBox" Grid.Column="1" Minimum="250" Maximum="5000" SmallChange="250" SpinButtonPlacementMode="Compact"                                           />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2"
                                BorderBrush="{ThemeResource LumenSubtleBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Background="{ThemeResource LumenSolidSurfaceBrush}"
                                Padding="20,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='24' x:Name="SettingsStatusTextBlock"
                                           Text=""
                                           VerticalAlignment="Center"
                                           Style="{StaticResource LumenMutedStyle}"
                                           FontSize="10.5" />
                                <Button x:ConnectionId='25' Grid.Column="1" Content="Cancel"                                Margin="8,0,0,0" Style="{StaticResource LumenGlassButtonStyle}" />
                                <Button x:ConnectionId='26' Grid.Column="2" Content="Save changes"                               Margin="8,0,0,0" Style="{StaticResource LumenAccentButtonStyle}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================= DETAILS ========================= -->
            <Grid x:ConnectionId='10' x:Name="DetailsModalOverlay"
                  Visibility="Collapsed"
                  Canvas.ZIndex="70">
                <Border x:ConnectionId='11' Background="#3A0B1415"                                  />
                <Border x:ConnectionId='12' x:Name="DetailsPanel"
                        Width="520"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Margin="0,14,14,14"
                        CornerRadius="24"
                        Background="{ThemeResource LumenElevatedBrush}"
                        BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                        BorderThickness="1"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:ConnectionId='21' x:Name="DetailsTitleTextBlock" Style="{StaticResource LumenHeadingStyle}" FontSize="21" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:ConnectionId='22' x:Name="DetailsAuthorTextBlock" Style="{StaticResource LumenMutedStyle}" FontSize="11" />
                            </StackPanel>
                            <Button x:ConnectionId='20' Grid.Column="1" Style="{StaticResource LumenIconButtonStyle}"                              >
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <ToolTipService.ToolTip>Close</ToolTipService.ToolTip>
                            </Button>
                        </Grid>
                        <Border x:ConnectionId='13' Grid.Row="1" CornerRadius="19" Background="#091011" BorderBrush="{ThemeResource LumenGlassBorderBrush}" BorderThickness="1"                                >
                            <Image x:ConnectionId='19' x:Name="DetailsPreviewImage" Stretch="UniformToFill" />
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10" Margin="0,12,0,12">
                            <TextBlock x:ConnectionId='16' x:Name="DetailsDescriptionTextBlock" Style="{StaticResource LumenBodyStyle}" TextWrapping="Wrap" MaxLines="4" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource LumenSurfaceBrush}" BorderBrush="{ThemeResource LumenSubtleBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,8" Margin="0,0,5,0">
                                    <TextBlock x:ConnectionId='18' x:Name="DetailsSpecsTextBlock" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" TextWrapping="Wrap" />
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource LumenSurfaceBrush}" BorderBrush="{ThemeResource LumenSubtleBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,8" Margin="5,0,0,0">
                                    <TextBlock x:ConnectionId='17' x:Name="DetailsTagsTextBlock" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7">
                            <Button x:ConnectionId='14' x:Name="DetailsSubscribeButton" Content="Download"                                   Style="{StaticResource LumenAccentButtonStyle}" />
                            <Button x:ConnectionId='15' x:Name="DetailsApplyButton" Content="Set wallpaper"                               Style="{StaticResource LumenGlassButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- ========================= STATUS BAR ========================= -->
        <Border Grid.Row="3"
                Margin="18,0"
                CornerRadius="15"
                Background="{ThemeResource LumenSurfaceBrush}"
                BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                BorderThickness="1"
                Padding="13,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#39D99B" />
                    <TextBlock x:ConnectionId='5' x:Name="StatusTextBlock" Text="Ready" Style="{StaticResource LumenMutedStyle}" FontSize="10.5" />
                </StackPanel>
                <TextBlock x:ConnectionId='4' x:Name="StorageSummaryTextBlock"
                           Grid.Column="1"
                           Text="Storage: 0 MB"
                           Style="{StaticResource LumenMutedStyle}"
                           FontSize="10.5"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

