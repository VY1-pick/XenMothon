<Window
    x:Class="Lumen.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Lumen.UI.ViewModels"
    xmlns:cat="using:Lumen.Core.Models.Catalog"
    mc:Ignorable="d"
    Title="Lumen — Live Wallpaper Platform">

    <Grid x:ConnectionId='2' x:Name="RootGrid" Background="{ThemeResource LumenPageBrush}">
        <Grid.Resources>
            <Style x:Key="SettingRowStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LumenSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource LumenSubtleBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style x:Key="SettingTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource LumenBodyStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="SettingHintStyle" TargetType="TextBlock" BasedOn="{StaticResource LumenMutedStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <ScalarTransition x:Key="LumenFadeTransition" Duration="0:0:0.18" />

            <!-- Ambient orbs drift slowly behind the glass -->
            <Storyboard x:Key="OrbStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="OrbATransform" Storyboard.TargetProperty="TranslateX" From="-40" To="120" Duration="0:0:16">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="OrbATransform" Storyboard.TargetProperty="TranslateY" From="0" To="90" Duration="0:0:19">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="OrbBTransform" Storyboard.TargetProperty="TranslateX" From="60" To="-130" Duration="0:0:21">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="OrbBTransform" Storyboard.TargetProperty="TranslateY" From="40" To="-80" Duration="0:0:17">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="OrbCTransform" Storyboard.TargetProperty="TranslateX" From="-60" To="80" Duration="0:0:23">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="OrbCTransform" Storyboard.TargetProperty="TranslateY" From="-40" To="70" Duration="0:0:20">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!-- ========================= AMBIENT BACKGROUND ========================= -->
        <Grid Grid.RowSpan="4" IsHitTestVisible="False">
            <Grid x:ConnectionId='147' x:Name="OrbA" Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-220,0,0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><CompositeTransform x:ConnectionId='152' x:Name="OrbATransform" /></Grid.RenderTransform>
                <Ellipse Fill="{ThemeResource LumenOrbMintBrush}" Opacity="0.14" />
                <Ellipse Fill="{ThemeResource LumenOrbMintBrush}" Opacity="0.16" Margin="90" />
                <Ellipse Fill="{ThemeResource LumenOrbMintBrush}" Opacity="0.22" Margin="190" />
            </Grid>
            <Grid x:ConnectionId='148' x:Name="OrbB" Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-300" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><CompositeTransform x:ConnectionId='151' x:Name="OrbBTransform" /></Grid.RenderTransform>
                <Ellipse Fill="{ThemeResource LumenOrbAquaBrush}" Opacity="0.14" />
                <Ellipse Fill="{ThemeResource LumenOrbAquaBrush}" Opacity="0.16" Margin="110" />
                <Ellipse Fill="{ThemeResource LumenOrbAquaBrush}" Opacity="0.22" Margin="220" />
            </Grid>
            <Grid x:ConnectionId='149' x:Name="OrbC" Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="260,-60,0,0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><CompositeTransform x:ConnectionId='150' x:Name="OrbCTransform" /></Grid.RenderTransform>
                <Ellipse Fill="{ThemeResource LumenOrbVioletBrush}" Opacity="0.10" />
                <Ellipse Fill="{ThemeResource LumenOrbVioletBrush}" Opacity="0.12" Margin="80" />
                <Ellipse Fill="{ThemeResource LumenOrbVioletBrush}" Opacity="0.16" Margin="160" />
            </Grid>
        </Grid>

        <!-- ========================= CUSTOM TITLE BAR ========================= -->
        <!-- Glass "tab" behind the native caption buttons so Minimize/Maximize/Close are always visible -->
        <Border x:ConnectionId='3' x:Name="CaptionBackplate"
                Grid.Row="0"
                Width="142"
                Height="48"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                CornerRadius="0,0,0,22"
                Background="{ThemeResource LumenGlassStrongBrush}"
                BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                BorderThickness="1,0,0,1" />

        <Grid x:ConnectionId='4' x:Name="AppTitleBar"
              Grid.Row="0"
              Background="{ThemeResource LumenTitleBarBrush}"
              Padding="20,0,150,0">
            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="10" Background="{ThemeResource LumenAccentSoftBrush}" Padding="3">
                    <Image Source="ms-appx:///Assets/lumen-logo.png" Stretch="Uniform" />
                </Border>
                <TextBlock Text="Lumen" Style="{StaticResource LumenHeadingStyle}" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="live wallpapers" Style="{StaticResource LumenMutedStyle}" FontSize="11" VerticalAlignment="Center" Margin="2,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- ========================= TOP NAV ========================= -->
        <Grid Grid.Row="1" Padding="20,4,20,8">
            <Border Style="{StaticResource LumenGlassCardStyle}" CornerRadius="28" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{ThemeResource LumenChipBrush}" CornerRadius="21" Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:ConnectionId='145' x:Name="NavExploreButton" Style="{StaticResource LumenNavButtonActiveStyle}"                            >
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71E;" FontSize="14" />
                                    <TextBlock Text="Explore" />
                                </StackPanel>
                            </Button>
                            <Button x:ConnectionId='146' x:Name="NavLibraryButton" Style="{StaticResource LumenNavButtonStyle}"                            >
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                    <TextBlock Text="Library" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:ConnectionId='140' x:Name="ImportButton" Style="{StaticResource LumenAccentButtonStyle}" CornerRadius="20" Padding="16,9"                              >
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='141' x:Name="RefreshButton" Style="{StaticResource LumenIconButtonStyle}"                         >
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <ToolTipService.ToolTip>Refresh</ToolTipService.ToolTip>
                        </Button>
                        <Button x:ConnectionId='142' x:Name="PauseResumeButton" Style="{StaticResource LumenIconButtonStyle}"                             >
                            <FontIcon x:ConnectionId='144' x:Name="PauseResumeIcon" Glyph="&#xE769;" FontSize="14" />
                            <ToolTipService.ToolTip>Pause / Resume wallpapers</ToolTipService.ToolTip>
                        </Button>
                        <Button x:ConnectionId='143' x:Name="SettingsButton" Style="{StaticResource LumenIconButtonStyle}"                          >
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                            <ToolTipService.ToolTip>Settings</ToolTipService.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================= MAIN CONTENT ========================= -->
        <Grid Grid.Row="2">
            <InfoBar x:ConnectionId='14' x:Name="ErrorNotificationBar"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="True"
                     VerticalAlignment="Top"
                     Margin="24,4,24,0"
                     Canvas.ZIndex="30" />

            <!-- ========================= EXPLORE ========================= -->
            <Grid x:ConnectionId='15' x:Name="ExploreContentGrid" Padding="20,2,20,0" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search + filters -->
                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="48"
                            Style="{StaticResource LumenGlassCardStyle}"
                            CornerRadius="24"
                            Padding="14,0,10,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="15" Foreground="{ThemeResource LumenMutedTextBrush}" VerticalAlignment="Center" />
                            <TextBox x:ConnectionId='138' x:Name="ExploreSearchBox"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource LumenSearchTextBoxStyle}"
                                     PlaceholderText="Search wallpapers, creators, moods, tags…"
                                                                      
                                                              >
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                </TextBox.Resources>
                            </TextBox>
                            <Button x:ConnectionId='139' x:Name="SearchClearButton"
                                    Grid.Column="2"
                                    Style="{StaticResource LumenIconButtonStyle}"
                                    Width="30" Height="30" CornerRadius="15"
                                    Visibility="Collapsed"
                                                                >
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                            <Border Grid.Column="3" Background="{ThemeResource LumenChipBrush}" CornerRadius="9" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl K" Style="{StaticResource LumenMutedStyle}" FontSize="10" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='120' x:Name="TypeFilterButton" Style="{StaticResource LumenFilterButtonStyle}" Height="48" CornerRadius="24">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE81E;" FontSize="13" />
                                <TextBlock x:ConnectionId='134' x:Name="TypeFilterLabel" Text="All types" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:ConnectionId='135' Text="All types" Tag="0"                                 />
                                    <MenuFlyoutItem x:ConnectionId='136' Text="Videos" Tag="1"                                 />
                                    <MenuFlyoutItem x:ConnectionId='137' Text="Images" Tag="2"                                 />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:ConnectionId='121' x:Name="ResolutionFilterButton" Style="{StaticResource LumenFilterButtonStyle}" Height="48" CornerRadius="24">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE91B;" FontSize="13" />
                                <TextBlock x:ConnectionId='129' x:Name="ResolutionFilterLabel" Text="All sizes" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:ConnectionId='130' Text="All sizes" Tag="0"                                       />
                                    <MenuFlyoutItem x:ConnectionId='131' Text="1080p FHD" Tag="1"                                       />
                                    <MenuFlyoutItem x:ConnectionId='132' Text="1440p QHD" Tag="2"                                       />
                                    <MenuFlyoutItem x:ConnectionId='133' Text="4K UHD" Tag="3"                                       />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:ConnectionId='122' x:Name="SortFilterButton" Style="{StaticResource LumenFilterButtonStyle}" Height="48" CornerRadius="24">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                                <TextBlock x:ConnectionId='123' x:Name="SortFilterLabel" Text="Relevance" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:ConnectionId='124' Text="Relevance" Tag="0"                                 />
                                    <MenuFlyoutItem x:ConnectionId='125' Text="Most popular" Tag="1"                                 />
                                    <MenuFlyoutItem x:ConnectionId='126' Text="Newest" Tag="2"                                 />
                                    <MenuFlyoutItem x:ConnectionId='127' Text="Top rated" Tag="3"                                 />
                                    <MenuFlyoutItem x:ConnectionId='128' Text="Title A–Z" Tag="4"                                 />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Categories -->
                <Grid Grid.Row="1" Margin="0,0,0,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListView x:ConnectionId='116' x:Name="CategoryListView"
                              Grid.Column="0"
                              SelectionMode="Single"
                              IsItemClickEnabled="False"
                              ItemContainerStyle="{StaticResource LumenChipListViewItemStyle}"
                              ScrollViewer.HorizontalScrollMode="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Height="40"
                                                                           >
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate                                 >
                                <TextBlock x:ConnectionId='119'                             FontSize="12" FontWeight="SemiBold" Padding="15,8" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:ConnectionId='117' x:Name="ExploreCountTextBlock" Grid.Column="1" Style="{StaticResource LumenMutedStyle}" FontSize="12" VerticalAlignment="Center" />
                </Grid>

                <!-- Trending tags -->
                <Grid Grid.Row="2" Margin="0,0,0,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8EC;" FontSize="12" Foreground="{ThemeResource LumenMutedTextBrush}" />
                        <TextBlock Text="Trending" Style="{StaticResource LumenMutedStyle}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                    <ListView x:ConnectionId='113' x:Name="TagsListView"
                              Grid.Column="1"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemContainerStyle="{StaticResource LumenChipListViewItemStyle}"
                              ScrollViewer.HorizontalScrollMode="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Height="34"
                                                        >
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate                      >
                                <TextBlock x:ConnectionId='115'                 FontSize="11.5" Padding="12,6" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Results -->
                <Grid Grid.Row="3">
                    <StackPanel x:ConnectionId='94' x:Name="ExploreLoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed">
                        <ProgressRing IsActive="True" Width="40" Height="40" />
                        <TextBlock Text="Curating wallpapers…" Style="{StaticResource LumenMutedStyle}" />
                    </StackPanel>

                    <StackPanel x:ConnectionId='95' x:Name="ExploreEmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="12" Visibility="Collapsed">
                        <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource LumenAccentGradientBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="30" Foreground="#04241F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nothing matched that vibe" Style="{StaticResource LumenHeadingStyle}" FontSize="22" HorizontalAlignment="Center" />
                        <TextBlock Text="Try another keyword, or reset the filters and look a little wider."
                                   Style="{StaticResource LumenMutedStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button x:ConnectionId='112' Content="Reset filters" Style="{StaticResource LumenAccentButtonStyle}" CornerRadius="20" HorizontalAlignment="Center"                               />
                    </StackPanel>

                    <GridView x:ConnectionId='96' x:Name="ExploreGridView"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              Padding="0,0,0,64"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate                                     >
                                <!-- Thumbnail-first card: the image IS the card. Text only appears on a soft scrim. -->
                                <Border x:ConnectionId='102' Width="268"
                                        Height="168"
                                        Margin="6"
                                        CornerRadius="22"
                                        BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                                        BorderThickness="1"
                                                                    
                                                                             
                                                                           >
                                    <Border.Background>
                                        <ImageBrush x:ConnectionId='103'                                       Stretch="UniformToFill" />
                                    </Border.Background>
                                    <Grid>
                                        <Border VerticalAlignment="Bottom" Height="76" CornerRadius="0,0,21,21" Background="{StaticResource LumenCardScrimBrush}" IsHitTestVisible="False" />

                                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,12" IsHitTestVisible="False">
                                            <TextBlock x:ConnectionId='110'                       Foreground="White" FontFamily="Segoe UI Variable Display" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:ConnectionId='111'                        Foreground="#CCFFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" CornerRadius="12" Padding="8,4" Background="#66041516" BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="False">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon x:ConnectionId='108'                            FontSize="10" Foreground="White" />
                                                <TextBlock x:ConnectionId='109'                                  FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Border>

                                        <Border x:ConnectionId='104' HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Width="24" Height="24" CornerRadius="12" Background="{StaticResource LumenAccentGradientBrush}"                                                 IsHitTestVisible="False">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#04241F" />
                                        </Border>

                                        <!-- Hover layer: actions only when the pointer is over the card -->
                                        <Grid x:Name="HoverLayer" Opacity="0" Background="#66020B0C">
                                            <Grid.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.18" />
                                            </Grid.OpacityTransition>
                                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button x:ConnectionId='106' Style="{StaticResource LumenOverlayIconButtonStyle}"                                            >
                                                    <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                                    <ToolTipService.ToolTip>Details</ToolTipService.ToolTip>
                                                </Button>
                                                <Button x:ConnectionId='107' Style="{StaticResource LumenAccentButtonStyle}" CornerRadius="18" Padding="16,8"                                                                                                   />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Compact pagination that floats; hidden when everything fits on one page -->
                    <Border x:ConnectionId='97' x:Name="PaginationPill"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10"
                            Style="{StaticResource LumenGlassPanelStyle}"
                            CornerRadius="18"
                            Padding="4"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:ConnectionId='98' x:Name="PrevPageButton" Style="{StaticResource LumenIconButtonStyle}" Width="28" Height="28" CornerRadius="14"                          >
                                <FontIcon Glyph="&#xE76B;" FontSize="10" />
                            </Button>
                            <TextBlock x:ConnectionId='99' x:Name="PageSummaryTextBlock" Style="{StaticResource LumenMutedStyle}" FontSize="11" VerticalAlignment="Center" MinWidth="34" TextAlignment="Center" />
                            <Button x:ConnectionId='100' x:Name="NextPageButton" Style="{StaticResource LumenIconButtonStyle}" Width="28" Height="28" CornerRadius="14"                          >
                                <FontIcon Glyph="&#xE76C;" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================= LIBRARY ========================= -->
            <Grid x:ConnectionId='16' x:Name="LibraryContentGrid"
                  Visibility="Collapsed"
                  Padding="20,2,20,0"
                  AllowDrop="True"
                                           
                                   >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource LumenGlassCardStyle}" CornerRadius="26" Padding="20,12" Margin="0,0,0,10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Your collection" Style="{StaticResource LumenHeadingStyle}" FontSize="19" />
                            <TextBlock Text="Drop files anywhere here to import them." Style="{StaticResource LumenMutedStyle}" FontSize="11" />
                        </StackPanel>
                        <Button x:ConnectionId='87' x:Name="StorageButton" Grid.Column="1" Style="{StaticResource LumenGlassButtonStyle}" CornerRadius="20">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                                <TextBlock Text="Storage" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:ConnectionId='89' x:Name="StorageFlyout">
                                    <StackPanel Spacing="10" Width="330" Padding="8">
                                        <TextBlock Text="Storage management" Style="{StaticResource LumenHeadingStyle}" FontSize="17" />
                                        <TextBlock x:ConnectionId='90' x:Name="StorageRootTextBlock" TextWrapping="Wrap" Style="{StaticResource LumenMutedStyle}" FontSize="11" />
                                        <TextBlock x:ConnectionId='91' x:Name="StorageUsageTextBlock" Style="{StaticResource LumenBodyStyle}" FontWeight="SemiBold" />
                                        <MenuFlyoutSeparator />
                                        <Button x:ConnectionId='92' x:Name="ReconcileButton" Content="Reconcile &amp; rebuild library" HorizontalAlignment="Stretch"                            />
                                        <Button x:ConnectionId='93' x:Name="ChangeStorageRootButton" Content="Change storage root…" HorizontalAlignment="Stretch"                                    />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:ConnectionId='88' Grid.Column="2" Style="{StaticResource LumenAccentButtonStyle}" CornerRadius="20"                              >
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Add wallpaper" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel x:ConnectionId='70' x:Name="LoadingPanel" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="44" Height="44" />
                    <TextBlock Text="Loading your collection…" Style="{StaticResource LumenMutedStyle}" />
                </StackPanel>

                <StackPanel x:ConnectionId='71' x:Name="EmptyStatePanel" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430" Spacing="12" Visibility="Collapsed">
                    <Border Width="92" Height="92" CornerRadius="46" Background="{StaticResource LumenAccentGradientBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8F1;" FontSize="38" Foreground="#04241F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Your library is a blank canvas" Style="{StaticResource LumenHeadingStyle}" FontSize="23" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop a wallpaper here, or download one from Explore. Thumbnails make it easy to pick by sight."
                               Style="{StaticResource LumenMutedStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:ConnectionId='86' Content="Import wallpapers" Style="{StaticResource LumenAccentButtonStyle}" CornerRadius="20" HorizontalAlignment="Center"                               />
                </StackPanel>

                <GridView x:ConnectionId='72' x:Name="WallpaperGridView"
                          Grid.Row="1"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Padding="0,0,0,12"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate                                       >
                            <Border x:ConnectionId='74' Width="300"
                                    Height="188"
                                    Margin="6"
                                    CornerRadius="22"
                                    BorderBrush="{ThemeResource LumenGlassBorderBrush}"
                                    BorderThickness="1"
                                                                         
                                                                       >
                                <Border.Background>
                                    <ImageBrush x:ConnectionId='75'                                       Stretch="UniformToFill" />
                                </Border.Background>
                                <Grid>
                                    <Border VerticalAlignment="Bottom" Height="80" CornerRadius="0,0,21,21" Background="{StaticResource LumenCardScrimBrush}" IsHitTestVisible="False" />

                                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,12" IsHitTestVisible="False">
                                        <TextBlock x:ConnectionId='84'                       Foreground="White" FontFamily="Segoe UI Variable Display" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:ConnectionId='85'                             Foreground="#CCFFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" CornerRadius="12" Padding="8,4" Background="#66041516" BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="False">
                                        <TextBlock x:ConnectionId='83'                           FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                    </Border>

                                    <!-- Per-wallpaper playback controls, shown while this wallpaper is the active one -->
                                    <StackPanel x:ConnectionId='76' Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"                                            >
                                        <Border Background="{StaticResource LumenAccentGradientBrush}" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="NOW PLAYING" FontSize="9" FontWeight="Bold" Foreground="#04241F" />
                                        </Border>
                                        <Button x:ConnectionId='79' Style="{StaticResource LumenOverlayIconButtonStyle}" Width="32" Height="32" CornerRadius="16"                           >
                                            <FontIcon x:ConnectionId='82'                                          FontSize="13" />
                                        </Button>
                                        <Button x:ConnectionId='80' Style="{StaticResource LumenOverlayIconButtonStyle}" Width="32" Height="32" CornerRadius="16"                          >
                                            <FontIcon x:ConnectionId='81'                                         FontSize="13" />
                                        </Button>
                                    </StackPanel>

                                    <Grid x:Name="HoverLayer" Opacity="0" Background="#66020B0C">
                                        <Grid.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.18" />
                                        </Grid.OpacityTransition>
                                        <Button x:ConnectionId='78' Style="{StaticResource LumenAccentButtonStyle}" CornerRadius="20" Padding="20,9" HorizontalAlignment="Center" VerticalAlignment="Center"                                            >
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                <TextBlock Text="Set wallpaper" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- ========================= SETTINGS ========================= -->
            <Grid x:ConnectionId='17' x:Name="SettingsOverlay" Visibility="Collapsed" Canvas.ZIndex="80">
                <Border x:ConnectionId='35' Background="{ThemeResource LumenScrimBrush}"                                   />
                <Border x:ConnectionId='36' x:Name="SettingsPanel"
                        Width="560"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Margin="0,6,20,10"
                        Style="{StaticResource LumenGlassPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="26,24,22,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Width="44" Height="44" CornerRadius="16" Background="{StaticResource LumenAccentGradientBrush}">
                                    <FontIcon Glyph="&#xE713;" Foreground="#04241F" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Settings" Style="{StaticResource LumenHeadingStyle}" FontSize="24" />
                                    <TextBlock Text="Make Lumen feel like yours." Style="{StaticResource LumenMutedStyle}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:ConnectionId='69' Grid.Column="1" Style="{StaticResource LumenIconButtonStyle}"                               >
                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                                <ToolTipService.ToolTip>Close settings</ToolTipService.ToolTip>
                            </Button>
                        </Grid>

                        <!-- Section tabs -->
                        <Border Grid.Row="1" Margin="22,0,22,10" Background="{ThemeResource LumenChipBrush}" CornerRadius="20" Padding="4">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:ConnectionId='65' x:Name="SettingsTabGeneral" Tag="General" Style="{StaticResource LumenNavButtonActiveStyle}" HorizontalAlignment="Stretch" Padding="6,8"                             >
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE713;" FontSize="12" /><TextBlock Text="General" FontSize="12" /></StackPanel>
                                </Button>
                                <Button x:ConnectionId='66' x:Name="SettingsTabAppearance" Grid.Column="1" Tag="Appearance" Style="{StaticResource LumenNavButtonStyle}" HorizontalAlignment="Stretch" Padding="6,8"                             >
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE790;" FontSize="12" /><TextBlock Text="Look" FontSize="12" /></StackPanel>
                                </Button>
                                <Button x:ConnectionId='67' x:Name="SettingsTabPlayback" Grid.Column="2" Tag="Playback" Style="{StaticResource LumenNavButtonStyle}" HorizontalAlignment="Stretch" Padding="6,8"                             >
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="12" /><TextBlock Text="Playback" FontSize="12" /></StackPanel>
                                </Button>
                                <Button x:ConnectionId='68' x:Name="SettingsTabPerformance" Grid.Column="3" Tag="Performance" Style="{StaticResource LumenNavButtonStyle}" HorizontalAlignment="Stretch" Padding="6,8"                             >
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE9D9;" FontSize="12" /><TextBlock Text="Speed" FontSize="12" /></StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid Padding="22,0,22,18">
                                <!-- General -->
                                <StackPanel x:ConnectionId='40' x:Name="SettingsGeneralSection" Spacing="10">
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Display name" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Used for your local profile" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <TextBox x:ConnectionId='64' x:Name="SettingsDisplayNameTextBox" Grid.Column="1" CornerRadius="12"                                            />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Start with Windows" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Launch quietly in the background at sign-in" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='63' x:Name="SettingsStartWithWindowsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"                                             />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Start minimized to tray" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Stay out of the way after sign-in" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='62' x:Name="SettingsStartMinimizedToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"                                           />
                                        </Grid>
                                    </Border>
                                    <Border Background="{ThemeResource LumenAccentSoftBrush}" CornerRadius="16" Padding="16,12">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource LumenTextBrush}" VerticalAlignment="Top" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Closing Lumen" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="The window hides to the system tray. Use the tray menu to exit completely." Style="{StaticResource SettingHintStyle}" MaxWidth="400" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Appearance -->
                                <StackPanel x:ConnectionId='41' x:Name="SettingsAppearanceSection" Spacing="10" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Theme" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Light, dark, or follow Windows" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ComboBox x:ConnectionId='61' x:Name="SettingsThemeComboBox" Grid.Column="1" Style="{StaticResource LumenSettingsComboBoxStyle}"                                          >
                                                <ComboBoxItem Content="Light" />
                                                <ComboBoxItem Content="Dark" />
                                                <ComboBoxItem Content="System" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Wallpaper scaling" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Default fit mode for new wallpapers" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ComboBox x:ConnectionId='60' x:Name="SettingsScalingComboBox" Grid.Column="1" Style="{StaticResource LumenSettingsComboBoxStyle}"                                            >
                                                <ComboBoxItem Content="Fill" />
                                                <ComboBoxItem Content="Fit" />
                                                <ComboBoxItem Content="Stretch" />
                                                <ComboBoxItem Content="Center" />
                                                <ComboBoxItem Content="Span" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Playback -->
                                <StackPanel x:ConnectionId='42' x:Name="SettingsPlaybackSection" Spacing="10" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Target FPS" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="15–240 frames per second" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <NumberBox x:ConnectionId='59' x:Name="SettingsFpsNumberBox" Grid.Column="1" Minimum="15" Maximum="240" SmallChange="5" SpinButtonPlacementMode="Compact" CornerRadius="12"                                     />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Default volume" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Applied to new video wallpapers" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <Slider x:ConnectionId='58' x:Name="SettingsDefaultVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5"                                               />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Start muted" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="New wallpapers begin without sound" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='57' x:Name="SettingsDefaultMutedToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"                                         />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Playback speed" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="0.25× to 2×" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <NumberBox x:ConnectionId='56' x:Name="SettingsPlaybackSpeedNumberBox" Grid.Column="1" Minimum="0.25" Maximum="2" SmallChange="0.25" SpinButtonPlacementMode="Compact" CornerRadius="12"                                               />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Loop wallpaper" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Restart media when it ends" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='55' x:Name="SettingsLoopToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"                                 />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Color tuning" Style="{StaticResource SettingTitleStyle}" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Brightness" Style="{StaticResource SettingHintStyle}" VerticalAlignment="Center" />
                                                <Slider x:ConnectionId='54' x:Name="SettingsBrightnessSlider" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="5"                                            />
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Contrast" Style="{StaticResource SettingHintStyle}" VerticalAlignment="Center" />
                                                <Slider x:ConnectionId='53' x:Name="SettingsContrastSlider" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="5"                                          />
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Saturation" Style="{StaticResource SettingHintStyle}" VerticalAlignment="Center" />
                                                <Slider x:ConnectionId='52' x:Name="SettingsSaturationSlider" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="5"                                            />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Performance -->
                                <StackPanel x:ConnectionId='43' x:Name="SettingsPerformanceSection" Spacing="10" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Pause on fullscreen apps" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Games and video players" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='51' x:Name="SettingsPauseFullscreenToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"                                            />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Pause on maximized windows" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Nothing to see behind them" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='50' x:Name="SettingsPauseMaximizedToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"                                           />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Pause on battery" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Save power on laptops" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='49' x:Name="SettingsPauseBatteryToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"                                         />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Pause when covered" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Stop decoding when the desktop is hidden" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='48' x:Name="SettingsPauseCoveredToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"                                         />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Covered threshold" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Pause once this share of a monitor is hidden" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Slider x:ConnectionId='46' x:Name="SettingsCoverageSlider" Minimum="50" Maximum="100" StepFrequency="5" Width="150"                                          />
                                                <TextBlock x:ConnectionId='47' x:Name="SettingsCoverageValueTextBlock" Text="85%" Width="40" VerticalAlignment="Center" Style="{StaticResource LumenBodyStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Mute audio when covered" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="Silence hidden wallpapers" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:ConnectionId='45' x:Name="SettingsMuteCoveredToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"                                        />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Check interval" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="250–5000 ms" Style="{StaticResource SettingHintStyle}" />
                                            </StackPanel>
                                            <NumberBox x:ConnectionId='44' x:Name="SettingsHeartbeatNumberBox" Grid.Column="1" Minimum="250" Maximum="5000" SmallChange="250" SpinButtonPlacementMode="Compact" CornerRadius="12"                                           />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Border Grid.Row="3" BorderBrush="{ThemeResource LumenSubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="22,14">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='37' x:Name="SettingsStatusTextBlock" VerticalAlignment="Center" Style="{StaticResource LumenMutedStyle}" FontSize="11" />
                                <Button x:ConnectionId='38' Grid.Column="1" Content="Cancel" Style="{StaticResource LumenGlassButtonStyle}" CornerRadius="20" Padding="18,9"                                />
                                <Button x:ConnectionId='39' Grid.Column="2" Content="Save changes" Style="{StaticResource LumenAccentButtonStyle}" CornerRadius="20" Padding="20,9"                               />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================= DETAILS ========================= -->
            <Grid x:ConnectionId='18' x:Name="DetailsModalOverlay" Visibility="Collapsed" Canvas.ZIndex="70">
                <Border x:ConnectionId='19' Background="{ThemeResource LumenScrimBrush}"                                  />
                <Border x:ConnectionId='20' x:Name="DetailsPanel"
                        Width="940"
                        MaxWidth="1100"
                        Height="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="24"
                        Style="{StaticResource LumenGlassPanelStyle}"
                        CornerRadius="30"
                                                     >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:ConnectionId='21' x:Name="DetailsPreviewBorder" Grid.Column="0" Margin="14" CornerRadius="22">
                            <Border.Background>
                                <ImageBrush x:ConnectionId='34' x:Name="DetailsPreviewBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>

                        <Grid Grid.Column="1" Padding="8,22,24,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock x:ConnectionId='32' x:Name="DetailsTitleTextBlock" Style="{StaticResource LumenHeadingStyle}" FontSize="23" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock x:ConnectionId='33' x:Name="DetailsAuthorTextBlock" Style="{StaticResource LumenMutedStyle}" FontSize="12" />
                                </StackPanel>
                                <Button x:ConnectionId='31' Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource LumenIconButtonStyle}" Width="34" Height="34" CornerRadius="17"                              >
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    <ToolTipService.ToolTip>Close</ToolTipService.ToolTip>
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,0">
                                <Border Background="{ThemeResource LumenChipBrush}" CornerRadius="14" Padding="12,8" HorizontalAlignment="Left">
                                    <TextBlock x:ConnectionId='30' x:Name="DetailsSpecsTextBlock" Style="{StaticResource LumenBodyStyle}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock x:ConnectionId='29' x:Name="DetailsStatsTextBlock" Style="{StaticResource LumenMutedStyle}" FontSize="12" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="14">
                                    <TextBlock x:ConnectionId='24' x:Name="DetailsDescriptionTextBlock" Style="{StaticResource LumenBodyStyle}" FontSize="13" TextWrapping="Wrap" />
                                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <ItemsRepeater x:ConnectionId='25' x:Name="DetailsTagsRepeater">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate                      >
                                                <Border x:ConnectionId='27' Background="{ThemeResource LumenAccentSoftBrush}" CornerRadius="13" Padding="10,4">
                                                    <TextBlock x:ConnectionId='28'                 FontSize="11" Style="{StaticResource LumenBodyStyle}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    </ScrollViewer>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="3" Spacing="8">
                                <Button x:ConnectionId='22' x:Name="DetailsSubscribeButton" HorizontalAlignment="Stretch" Content="Download" Style="{StaticResource LumenAccentButtonStyle}" CornerRadius="22" Padding="16,12"                                   />
                                <Button x:ConnectionId='23' x:Name="DetailsApplyButton" HorizontalAlignment="Stretch" Content="Set as wallpaper" Style="{StaticResource LumenGlassButtonStyle}" CornerRadius="22" Padding="16,12"                               />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================= NOW PLAYING / STATUS ========================= -->
        <Border Grid.Row="3" Margin="20,0,20,12" Style="{StaticResource LumenGlassCardStyle}" CornerRadius="24" Padding="16,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#2EE6B8" />
                    <TextBlock x:ConnectionId='13' x:Name="StatusTextBlock" Text="Ready" Style="{StaticResource LumenMutedStyle}" FontSize="12" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel x:ConnectionId='5' x:Name="NowPlayingPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{ThemeResource LumenMutedTextBrush}" />
                    <TextBlock x:ConnectionId='7' x:Name="NowPlayingTitleTextBlock" Style="{StaticResource LumenBodyStyle}" FontSize="12" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button x:ConnectionId='8' Style="{StaticResource LumenIconButtonStyle}" Width="32" Height="32" CornerRadius="16"                           >
                        <FontIcon x:ConnectionId='12' x:Name="NowPlayingPauseIcon" Glyph="&#xE769;" FontSize="13" />
                        <ToolTipService.ToolTip>Play / Pause</ToolTipService.ToolTip>
                    </Button>
                    <Button x:ConnectionId='9' Style="{StaticResource LumenIconButtonStyle}" Width="32" Height="32" CornerRadius="16"                          >
                        <FontIcon x:ConnectionId='11' x:Name="NowPlayingMuteIcon" Glyph="&#xE767;" FontSize="13" />
                        <ToolTipService.ToolTip>Mute / Unmute</ToolTipService.ToolTip>
                    </Button>
                    <Button x:ConnectionId='10' Style="{StaticResource LumenIconButtonStyle}" Width="32" Height="32" CornerRadius="16"                      >
                        <FontIcon Glyph="&#xE71A;" FontSize="12" />
                        <ToolTipService.ToolTip>Stop wallpaper</ToolTipService.ToolTip>
                    </Button>
                </StackPanel>

                <TextBlock x:ConnectionId='6' x:Name="StorageSummaryTextBlock" Grid.Column="2" Text="Storage: 0 MB" Style="{StaticResource LumenMutedStyle}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

