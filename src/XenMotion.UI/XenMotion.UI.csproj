<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>XenMotion.UI</RootNamespace>
    <AssemblyName>XenMotion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\xenmotion-logo.ico</ApplicationIcon>
    <Product>XenMotion</Product>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>XenMotion.UI.Program</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.2-beta</Version>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <InformationalVersion>0.1.2-beta</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XenMotion.Core\XenMotion.Core.csproj" />
    <ProjectReference Include="..\XenMotion.Contracts\XenMotion.Contracts.csproj" />
    <ProjectReference Include="..\XenMotion.Application\XenMotion.Application.csproj" />
    <ProjectReference Include="..\XenMotion.Infrastructure.Persistence\XenMotion.Infrastructure.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\xenmotion-logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\xenmotion-logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Catalog\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
