<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XenMotion.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XenMotion.UI"
    xmlns:vm="using:XenMotion.UI.ViewModels"
    xmlns:cat="using:XenMotion.Core.Models.Catalog">

  <Grid x:Name="RootGrid" Background="{StaticResource XenMotionPageBrush}" RequestedTheme="Dark">
    <Grid.Resources>

      <!-- Thumbnail-first gallery cards; all commands live in the details dock. -->
      <DataTemplate x:Key="ExploreCardTemplate" x:DataType="vm:CatalogItemViewModel">
        <Grid Width="216" Height="216" Background="Transparent" ToolTipService.ToolTip="{x:Bind Title}">
          <Border Margin="3" CornerRadius="16">
            <Border.Background><ImageBrush ImageSource="{x:Bind ThumbnailImage}" Stretch="UniformToFill" /></Border.Background>
          </Border>
          <Border Margin="3" Height="28" VerticalAlignment="Bottom" CornerRadius="0,0,16,16" Background="{StaticResource XenMotionCardScrimBrush}" Padding="8,4">
            <TextBlock Text="{x:Bind Title}" FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Border>
          <Border CornerRadius="18" BorderBrush="{StaticResource XenMotionRimSoftBrush}" BorderThickness="1" IsHitTestVisible="False" />
          <Border CornerRadius="18" BorderBrush="{StaticResource XenMotionMintTextBrush}" BorderThickness="2" Visibility="{x:Bind IsSelected, Mode=OneWay}" IsHitTestVisible="False" />
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="LibraryCardTemplate" x:DataType="vm:WallpaperItemViewModel">
        <Grid Width="216" Height="216" Background="Transparent" ToolTipService.ToolTip="{x:Bind Title}">
          <Border Margin="3" CornerRadius="16">
            <Border.Background><ImageBrush ImageSource="{x:Bind ThumbnailImage}" Stretch="UniformToFill" /></Border.Background>
          </Border>
          <Border Margin="3" Height="28" VerticalAlignment="Bottom" CornerRadius="0,0,16,16" Background="{StaticResource XenMotionCardScrimBrush}" Padding="8,4">
            <TextBlock Text="{x:Bind Title}" FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Border>
          <Border CornerRadius="18" BorderBrush="{StaticResource XenMotionRimSoftBrush}" BorderThickness="1" IsHitTestVisible="False" />
          <Border CornerRadius="18" BorderBrush="{StaticResource XenMotionMintTextBrush}" BorderThickness="2" Visibility="{x:Bind IsSelected, Mode=OneWay}" IsHitTestVisible="False" />
          <Ellipse Width="7" Height="7" Margin="11" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{StaticResource XenMotionMintTextBrush}" Visibility="{x:Bind IsActive, Mode=OneWay}" IsHitTestVisible="False" />
        </Grid>
      </DataTemplate>

      <!-- ============================ small pieces ============================ -->
      <DataTemplate x:Key="CategoryChipTemplate" x:DataType="cat:CatalogCategory">
        <ToggleButton Style="{StaticResource XenMotionChipStyle}" Click="OnCategoryChipClicked" Tag="{x:Bind Id}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="{x:Bind IconGlyph}" FontSize="13" />
            <TextBlock Text="{x:Bind DisplayName}" />
          </StackPanel>
        </ToggleButton>
      </DataTemplate>

      <DataTemplate x:Key="TagPillTemplate" x:DataType="x:String">
        <Button Style="{StaticResource XenMotionGhostButtonStyle}" MinHeight="30" Height="30" Padding="12,0" CornerRadius="15" FontWeight="Medium" FontSize="12"
                Background="{StaticResource XenMotionSectionBrush}" Tag="{x:Bind}" Click="OnTagPillClicked">
          <TextBlock>
            <Run Text="#" Foreground="{StaticResource XenMotionMintTextBrush}" /><Run Text="{x:Bind}" />
          </TextBlock>
        </Button>
      </DataTemplate>

    </Grid.Resources>

    <!-- ============================ ambient light ============================ -->
    <Grid x:Name="AmbientBlueHost" Width="820" Height="820" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-330,-260,0" IsHitTestVisible="False" />
    <Grid x:Name="AmbientVioletHost" Width="1000" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-420,-480" IsHitTestVisible="False" />
    <Grid x:Name="AmbientMintHost" Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-460,0,0,-540" IsHitTestVisible="False" />
    <!-- the mint glow that sits beside the logo and fades with distance -->
    <Grid x:Name="HeaderGlowHost" Width="820" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-330,-124,0,0" IsHitTestVisible="False" />

    <Grid x:Name="ShellGrid" Margin="0" Background="{StaticResource XenMotionSectionBrush}" CornerRadius="8" BorderBrush="{StaticResource XenMotionRimSoftBrush}" BorderThickness="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="72" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ================================ HEADER (transparent) ================================ -->
      <Grid x:Name="HeaderBar" Grid.Row="0" Padding="22,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource XenMotionHairlineBrush}" IsHitTestVisible="False" Margin="-22,0,-10,0" />

        <StackPanel x:Name="BrandPanel" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="13" Background="{StaticResource XenMotionGlassStrongBrush}" BorderBrush="{StaticResource XenMotionAccentRimBrush}" BorderThickness="1">
            <Image Source="ms-appx:///Assets/xenmotion-logo.png" Width="26" Height="26" Stretch="Uniform" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="XenMotion" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource XenMotionTextBrush}" />
            <TextBlock Text="LIVE WALLPAPERS" Style="{StaticResource XenMotionEyebrowTextStyle}" FontSize="9" />
          </StackPanel>
        </StackPanel>

        <Border x:Name="NavPill" Grid.Column="1" Margin="34,0,0,0" Style="{StaticResource XenMotionGlassPanelStyle}" CornerRadius="17" Padding="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="NavExploreButton" Style="{StaticResource XenMotionSegmentStyle}" Click="OnNavExploreClicked">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE774;" FontSize="14" /><TextBlock Text="Explore" /></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="NavLibraryButton" Style="{StaticResource XenMotionSegmentStyle}" Click="OnNavLibraryClicked">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE8F1;" FontSize="14" /><TextBlock Text="Library" /></StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>

        <Grid x:Name="DragRegion" Grid.Column="2" Background="Transparent" />

        <StackPanel x:Name="HeaderActions" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button x:Name="ImportButton" Style="{StaticResource XenMotionButtonStyle}" Click="OnImportButtonClicked" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Import" /></StackPanel>
          </Button>
          <Button x:Name="RefreshButton" Style="{StaticResource XenMotionIconButtonStyle}" Click="OnRefreshClicked" ToolTipService.ToolTip="Refresh"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE72C;" FontSize="15" /></Button>
          <Button x:Name="SettingsButton" Style="{StaticResource XenMotionIconButtonStyle}" Click="OnSettingsClicked" ToolTipService.ToolTip="Settings"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE713;" FontSize="15" /></Button>
        </StackPanel>

        <Border x:Name="CaptionPanel" Grid.Column="4" Style="{StaticResource XenMotionGlassPanelStyle}" CornerRadius="16" Padding="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="MinimizeButton" Style="{StaticResource XenMotionCaptionButtonStyle}" Click="OnMinimizeClicked" ToolTipService.ToolTip="Minimize"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE921;" FontSize="10" /></Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource XenMotionCaptionButtonStyle}" Click="OnMaximizeClicked" ToolTipService.ToolTip="Maximize">
              <FontIcon x:Name="MaximizeGlyph" Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE922;" FontSize="10" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource XenMotionCaptionCloseStyle}" Click="OnCloseClicked" ToolTipService.ToolTip="Close to tray"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE8BB;" FontSize="10" /></Button>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ================================ BODY ================================ -->
      <Grid x:Name="BodyGrid" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ContentHost" Grid.Column="0">

          <!-- EXPLORE -->
          <Grid x:Name="ExploreContentGrid" Margin="28,14,24,0" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border x:Name="SearchField" Style="{StaticResource XenMotionFieldStyle}" Height="48" CornerRadius="24" Padding="18,0,10,0">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE721;" FontSize="15" Foreground="{StaticResource XenMotionFaintTextBrush}" VerticalAlignment="Center"/>
                  <TextBox x:Name="ExploreSearchBox" Grid.Column="1" Style="{StaticResource XenMotionTextBoxStyle}" VerticalAlignment="Center"
                           PlaceholderText="Search wallpapers, moods, tags..." TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                  <Button x:Name="SearchClearButton" Grid.Column="2" Style="{StaticResource XenMotionSmallIconButtonStyle}" Background="Transparent" BorderThickness="0"
                          Click="OnSearchClearClicked" Visibility="Collapsed" VerticalAlignment="Center"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE711;" FontSize="11" /></Button>
                  <Border Grid.Column="3" Style="{StaticResource XenMotionBadgeStyle}" VerticalAlignment="Center" Background="#14FFFFFF">
                    <TextBlock Text="Ctrl K" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource XenMotionFaintTextBrush}" />
                  </Border>
                </Grid>
              </Border>
              <ToggleButton x:Name="FiltersToggleButton" Grid.Column="1" Style="{StaticResource XenMotionChipStyle}" MinHeight="48" Padding="20,0" CornerRadius="24" Click="OnFiltersToggleClicked">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE71C;" FontSize="14" />
                  <TextBlock Text="Filters" VerticalAlignment="Center" />
                  <Border x:Name="FilterCountBadge" Visibility="Collapsed" Background="{StaticResource XenMotionAccentBrush}" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0">
                    <TextBlock x:Name="FilterCountText" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource XenMotionOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </StackPanel>
              </ToggleButton>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
              <ItemsRepeater x:Name="CategoryRepeater" ItemTemplate="{StaticResource CategoryChipTemplate}">
                <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="8" /></ItemsRepeater.Layout>
              </ItemsRepeater>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollViewer x:Name="TagsScroller" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="TRENDING" Style="{StaticResource XenMotionEyebrowTextStyle}" VerticalAlignment="Center" Margin="2,0,4,0" />
                  <ItemsRepeater x:Name="TagsRepeater" ItemTemplate="{StaticResource TagPillTemplate}">
                    <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="8" /></ItemsRepeater.Layout>
                  </ItemsRepeater>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="ExploreCountTextBlock" Style="{StaticResource XenMotionCaptionTextStyle}" VerticalAlignment="Center" />
                <Button x:Name="ClearFiltersLink" Style="{StaticResource XenMotionGhostButtonStyle}" MinHeight="28" Height="28" Padding="10,0" CornerRadius="14" FontSize="12"
                        Foreground="{StaticResource XenMotionMintTextBrush}" Click="OnClearFiltersClicked" Visibility="Collapsed" Content="Clear all" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
              <GridView x:Name="ExploreGridView" ItemTemplate="{StaticResource ExploreCardTemplate}" ItemContainerStyle="{StaticResource XenMotionCardItemStyle}"
                        SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCatalogItemClicked" Padding="0,4,0,120" ScrollViewer.VerticalScrollBarVisibility="Auto" />

              <StackPanel x:Name="ExploreLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="44" Height="44" />
                <TextBlock Text="Finding wallpapers..." Style="{StaticResource XenMotionCaptionTextStyle}" HorizontalAlignment="Center" />
              </StackPanel>

              <StackPanel x:Name="ExploreEmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed" MaxWidth="360">
                <Border Width="72" Height="72" CornerRadius="26" HorizontalAlignment="Center" Style="{StaticResource XenMotionGlassPanelStyle}">
                  <FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE721;" FontSize="26" Foreground="{StaticResource XenMotionMintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Nothing matches yet" Style="{StaticResource XenMotionHeadingTextStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Try a different word, or loosen a few filters." Style="{StaticResource XenMotionBodyTextStyle}" TextAlignment="Center" HorizontalAlignment="Center" />
                <Button Style="{StaticResource XenMotionButtonStyle}" HorizontalAlignment="Center" Content="Reset everything" Click="OnClearFiltersClicked" />
              </StackPanel>

              <Border x:Name="PaginationPill" Style="{StaticResource XenMotionGlassStrongPanelStyle}" CornerRadius="18" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,22" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="PrevPageButton" Style="{StaticResource XenMotionSmallIconButtonStyle}" Background="Transparent" BorderThickness="0" Click="OnPrevPageClicked" ToolTipService.ToolTip="Previous page"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE76B;" FontSize="11" /></Button>
                  <TextBlock x:Name="PageSummaryTextBlock" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource XenMotionTextBrush}" VerticalAlignment="Center" MinWidth="42" TextAlignment="Center" />
                  <Button x:Name="NextPageButton" Style="{StaticResource XenMotionSmallIconButtonStyle}" Background="Transparent" BorderThickness="0" Click="OnNextPageClicked" ToolTipService.ToolTip="Next page"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE76C;" FontSize="11" /></Button>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- LIBRARY -->
          <Grid x:Name="LibraryContentGrid" Margin="28,14,28,0" RowSpacing="16" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock Text="Your library" Style="{StaticResource XenMotionTitleTextStyle}" />
                <TextBlock x:Name="LibrarySubtitleText" Style="{StaticResource XenMotionCaptionTextStyle}" FontSize="12" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="LibrarySelectionToggle" Content="Select" Click="OnLibrarySelectionClicked" Style="{StaticResource XenMotionChipStyle}" />
                <Button x:Name="LibrarySelectAllButton" Content="All" Click="OnSelectAllWallpapersClicked" Visibility="Collapsed" />
                <Button x:Name="LibraryDeleteSelectedButton" Content="Remove selected" Click="OnDeleteSelectedWallpapersClicked" Visibility="Collapsed" />
              </StackPanel>
              <Button x:Name="StorageButton" Grid.Column="2" Style="{StaticResource XenMotionButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xEDA2;" FontSize="14" /><TextBlock Text="Storage" /></StackPanel>
                <Button.Flyout>
                  <Flyout x:Name="StorageFlyout" Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource XenMotionFlyoutPresenterStyle}">
                    <StackPanel Width="320" Spacing="14" Padding="10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="STORAGE" Style="{StaticResource XenMotionEyebrowTextStyle}" />
                        <TextBlock x:Name="StorageUsageTextBlock" Style="{StaticResource XenMotionHeadingTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StorageRootTextBlock" Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                      </StackPanel>
                      <Rectangle Height="1" Fill="{StaticResource XenMotionDividerBrush}" />
                      <Button Style="{StaticResource XenMotionButtonStyle}" HorizontalAlignment="Stretch" Click="OnReconcileClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE895;" FontSize="13" /><TextBlock Text="Rescan library" /></StackPanel>
                      </Button>
                      <Button Style="{StaticResource XenMotionButtonStyle}" HorizontalAlignment="Stretch" Click="OnChangeStorageRootClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE8B7;" FontSize="13" /><TextBlock Text="Move library folder..." /></StackPanel>
                      </Button>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>

            <Grid Grid.Row="1" x:Name="LibraryDropZone" AllowDrop="True" Background="Transparent" DragOver="OnGridDragOver" Drop="OnGridDrop">
              <GridView x:Name="WallpaperGridView" ItemTemplate="{StaticResource LibraryCardTemplate}" ItemContainerStyle="{StaticResource XenMotionCardItemStyle}"
                        SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnLibraryItemClicked" SelectionChanged="OnLibrarySelectionChanged" Padding="0,4,0,120" ScrollViewer.VerticalScrollBarVisibility="Auto" />

              <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="44" Height="44" />
                <TextBlock Text="Opening your library..." Style="{StaticResource XenMotionCaptionTextStyle}" HorizontalAlignment="Center" />
              </StackPanel>

              <Border x:Name="EmptyStatePanel" Style="{StaticResource XenMotionGlassPanelStyle}" CornerRadius="30" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="44,40" Visibility="Collapsed">
                <StackPanel Spacing="14" Width="330">
                  <Border Width="76" Height="76" CornerRadius="28" HorizontalAlignment="Center" Background="{StaticResource XenMotionAccentSoftBrush}" BorderBrush="{StaticResource XenMotionAccentRimBrush}" BorderThickness="1">
                    <FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE8B9;" FontSize="28" Foreground="{StaticResource XenMotionMintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Nothing here yet" Style="{StaticResource XenMotionHeadingTextStyle}" HorizontalAlignment="Center" />
                  <TextBlock Text="Drop images or videos anywhere in this window, or grab something beautiful from Explore." Style="{StaticResource XenMotionBodyTextStyle}" TextAlignment="Center" />
                  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Style="{StaticResource XenMotionPrimaryButtonStyle}" Click="OnImportButtonClicked">
                      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Import files" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource XenMotionButtonStyle}" Content="Browse Explore" Click="OnNavExploreClicked" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>

        <!-- Selection inspector: stays beside the gallery, with its own scroll position. -->
        <Border x:Name="DetailsDock" RequestedTheme="Dark" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,14,20,20"
                Background="{StaticResource XenMotionPageBrush}" BorderThickness="0" CornerRadius="20" Visibility="Collapsed">
          <Grid Background="{StaticResource XenMotionSectionBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="ViewerHeaderGlowHost" Width="480" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-130,0,0" IsHitTestVisible="False" Grid.RowSpan="2" />
            <Grid x:Name="ViewerBlueGlowHost" Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-330,-280,0" IsHitTestVisible="False" Grid.RowSpan="2" />
            <Grid x:Name="ViewerVioletGlowHost" Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-350,-390" IsHitTestVisible="False" Grid.RowSpan="2" />
            <Grid x:Name="ViewerMintGlowHost" Width="650" Height="650" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-330,0,0,-400" IsHitTestVisible="False" Grid.RowSpan="2" />
              <Grid Margin="18,14,18,8">
                <Grid x:Name="DetailsDragRegion" Margin="0,0,88,0" Background="Transparent">
                  <TextBlock x:Name="DetailsWindowTitle" Text="WALLPAPER" Style="{StaticResource XenMotionEyebrowTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <ToggleButton x:Name="DetailsDetachButton" Style="{StaticResource XenMotionChipStyle}" HorizontalAlignment="Right" Margin="0,0,42,0" Padding="9" Click="OnDetachViewerClicked"
                              AutomationProperties.Name="Hide main window" ToolTipService.ToolTip="Hide main window">
                  <FontIcon x:Name="DetailsDetachIcon" Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE89F;" FontSize="12" />
                </ToggleButton>
                <Button Style="{StaticResource XenMotionSmallIconButtonStyle}" HorizontalAlignment="Right" Click="OnCloseDetailsClicked"
                        AutomationProperties.Name="Close wallpaper details" ToolTipService.ToolTip="Close details">
                  <FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE711;" FontSize="12" />
                </Button>
              </Grid>
          <ScrollViewer x:Name="DetailsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" Padding="18,8,18,18">
              <Border x:Name="DetailsPreviewFrame" Height="177.75" SizeChanged="OnDetailsPreviewSizeChanged" CornerRadius="18" Background="{StaticResource XenMotionGlassDarkBrush}"
                      BorderBrush="{StaticResource XenMotionRimBrush}" BorderThickness="1">
                <Grid>
                  <Border CornerRadius="18">
                    <Border.Background><ImageBrush x:Name="DetailsPreviewBrush" Stretch="Uniform" /></Border.Background>
                  </Border>
                  <MediaPlayerElement x:Name="DetailsMotionPreview" AreTransportControlsEnabled="False" Stretch="Uniform" Visibility="Collapsed" />
                </Grid>
              </Border>
              <Button x:Name="DetailsMotionButton" Style="{StaticResource XenMotionButtonStyle}" Content="Motion preview" Click="OnMotionPreviewClicked" Visibility="Collapsed" />
              <StackPanel Spacing="8">
                <TextBlock x:Name="DetailsCategoryTextBlock" Style="{StaticResource XenMotionEyebrowTextStyle}" />
                <TextBlock x:Name="DetailsTitleTextBlock" Style="{StaticResource XenMotionTitleTextStyle}" FontSize="23" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource XenMotionAccentSoftBrush}">
                    <FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE77B;" FontSize="13" Foreground="{StaticResource XenMotionMintTextBrush}" />
                  </Border>
                  <TextBlock x:Name="DetailsAuthorTextBlock" Foreground="{StaticResource XenMotionMintTextBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="270" />
                </StackPanel>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock x:Name="DetailsResolutionText" Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Style="{StaticResource XenMotionBadgeStyle}"><TextBlock x:Name="DetailsAspectText" Foreground="{StaticResource XenMotionMintTextBrush}" FontSize="11" /></Border>
                  <TextBlock x:Name="DetailsSizeText" Style="{StaticResource XenMotionCaptionTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="DetailsStatsTextBlock" Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
              <ItemsRepeater x:Name="DetailsTagsRepeater">
                <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="90" MinItemHeight="28" MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Background="{StaticResource XenMotionAccentSoftBrush}" CornerRadius="12" Padding="9,5">
                      <TextBlock Text="{x:Bind}" Foreground="{StaticResource XenMotionMintTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
              <TextBlock x:Name="DetailsSubscriptionText" Foreground="{StaticResource XenMotionMintTextBrush}" FontSize="12" />
              <ProgressBar x:Name="DetailsProgressBar" Minimum="0" Maximum="100" Height="4" Visibility="Collapsed" />
              <Button x:Name="DetailsPrimaryButton" Style="{StaticResource XenMotionPrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="44" Click="OnDetailsPrimaryClicked" />
              <StackPanel x:Name="DetailsPlaybackActions" Spacing="8" Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Button x:Name="DetailsPauseButton" Style="{StaticResource XenMotionButtonStyle}" Content="Pause" HorizontalAlignment="Stretch" Click="OnPauseResumeClicked" />
                  <Button x:Name="DetailsMuteButton" Grid.Column="1" Style="{StaticResource XenMotionButtonStyle}" Content="Mute" HorizontalAlignment="Stretch" Click="OnMuteClicked" />
                </Grid>
                <Button Style="{StaticResource XenMotionButtonStyle}" Content="Stop wallpaper" HorizontalAlignment="Stretch" Click="OnStopClicked" />
              </StackPanel>
              <Button x:Name="DetailsRemoveButton" Style="{StaticResource XenMotionDangerButtonStyle}" Content="Remove from library" HorizontalAlignment="Stretch" Click="OnDeleteWallpaperClicked" Visibility="Collapsed" />
              <Rectangle Height="1" Fill="{StaticResource XenMotionHairlineBrush}" />
              <StackPanel x:Name="WallpaperEditorPanel" Spacing="14" Visibility="Collapsed" />
              <TextBlock x:Name="DetailsDescriptionTextBlock" Style="{StaticResource XenMotionBodyTextStyle}" />
            </StackPanel>
          </ScrollViewer>
          </Grid>
        </Border>

        <!-- ============ ADVANCED FILTER DOCK: attached to the page edge, separate surface ============ -->
        <Grid x:Name="FilterDock" Grid.Column="1" Visibility="Collapsed" Width="392" Opacity="0">
          <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.22" /></Grid.OpacityTransition>
          <Grid.TranslationTransition><Vector3Transition Duration="0:0:0.3" /></Grid.TranslationTransition>
          <Border Style="{StaticResource XenMotionGlassStrongPanelStyle}" CornerRadius="20" BorderThickness="0" />
          <!-- seam light where the dock meets the page -->
          <Rectangle Width="2" HorizontalAlignment="Left" Margin="0,28,0,0" Fill="{StaticResource XenMotionAccentRimBrush}" Opacity="0.55" IsHitTestVisible="False" />
          <Grid Padding="22,20,22,18" RowSpacing="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="FiltersDragRegion" Background="Transparent" Spacing="2">
                <TextBlock Text="ADVANCED" Style="{StaticResource XenMotionEyebrowTextStyle}" />
                <TextBlock Text="Filters" Style="{StaticResource XenMotionTitleTextStyle}" FontSize="24" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource XenMotionSmallIconButtonStyle}" VerticalAlignment="Top" Click="OnFiltersToggleClicked" ToolTipService.ToolTip="Close filters"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE711;" FontSize="12" /></Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource XenMotionGlassPanelStyle}" CornerRadius="15" Padding="4">
              <Grid ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="FilterTabBasics" Grid.Column="0" Style="{StaticResource XenMotionTabStyle}" HorizontalAlignment="Stretch" Tag="Basics" Click="OnFilterTabClicked" Content="Basics" />
                <ToggleButton x:Name="FilterTabQuality" Grid.Column="1" Style="{StaticResource XenMotionTabStyle}" HorizontalAlignment="Stretch" Tag="Quality" Click="OnFilterTabClicked" Content="Quality" />
                <ToggleButton x:Name="FilterTabLength" Grid.Column="2" Style="{StaticResource XenMotionTabStyle}" HorizontalAlignment="Stretch" Tag="Length" Click="OnFilterTabClicked" Content="Length" />
                <ToggleButton x:Name="FilterTabTags" Grid.Column="3" Style="{StaticResource XenMotionTabStyle}" HorizontalAlignment="Stretch" Tag="Tags" Click="OnFilterTabClicked" Content="Tags" />
              </Grid>
            </Border>

            <Grid Grid.Row="2">
              <ScrollViewer x:Name="FilterBasicsSection" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel Spacing="12">
                  <Border Style="{StaticResource XenMotionSectionStyle}">
            <StackPanel Spacing="12">
              <TextBlock Text="Wallpaper type" Style="{StaticResource XenMotionLabelTextStyle}" />
              <TextBlock Text="Moving scenes or still pictures." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
              <ItemsRepeater x:Name="TypeRepeater">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="100" MinItemHeight="38" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Style="{StaticResource XenMotionChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="38">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                  </ToggleButton>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </Border>
                  <Border Style="{StaticResource XenMotionSectionStyle}">
            <StackPanel Spacing="12">
              <TextBlock Text="Sort by" Style="{StaticResource XenMotionLabelTextStyle}" />
              <TextBlock Text="How the results are ordered." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
              <ItemsRepeater x:Name="SortRepeater">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinItemHeight="38" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Style="{StaticResource XenMotionChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="38">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                  </ToggleButton>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </Border>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer x:Name="FilterQualitySection" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                <StackPanel Spacing="12">
                  <Border Style="{StaticResource XenMotionSectionStyle}">
            <StackPanel Spacing="12">
              <TextBlock Text="Resolution" Style="{StaticResource XenMotionLabelTextStyle}" />
              <TextBlock Text="Smallest size you want to see." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
              <ItemsRepeater x:Name="ResolutionRepeater">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinItemHeight="38" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Style="{StaticResource XenMotionChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="38">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                  </ToggleButton>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </Border>
                  <Border Style="{StaticResource XenMotionSectionStyle}">
            <StackPanel Spacing="12">
              <TextBlock Text="Shape" Style="{StaticResource XenMotionLabelTextStyle}" />
              <TextBlock Text="Match the proportions of your display." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
              <ItemsRepeater x:Name="OrientationRepeater">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinItemHeight="38" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Style="{StaticResource XenMotionChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="38">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                  </ToggleButton>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </Border>
                  <Border Style="{StaticResource XenMotionSectionStyle}">
                    <StackPanel Spacing="10">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Minimum rating" Style="{StaticResource XenMotionLabelTextStyle}" />
                        <TextBlock x:Name="MinRatingText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource XenMotionMintTextBrush}" />
                      </Grid>
                      <Slider x:Name="MinRatingSlider" Minimum="0" Maximum="5" StepFrequency="0.5" SmallChange="0.5" ValueChanged="OnMinRatingChanged" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer x:Name="FilterLengthSection" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                <StackPanel Spacing="12">
                  <Border Style="{StaticResource XenMotionSectionStyle}">
            <StackPanel Spacing="12">
              <TextBlock Text="Video length" Style="{StaticResource XenMotionLabelTextStyle}" />
              <TextBlock Text="Only affects videos. Pictures are always shown." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
              <ItemsRepeater x:Name="DurationRepeater">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinItemHeight="38" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Style="{StaticResource XenMotionChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="38">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                  </ToggleButton>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </Border>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer x:Name="FilterTagsSection" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                <StackPanel Spacing="12">
                  <Border Style="{StaticResource XenMotionSectionStyle}">
                    <StackPanel Spacing="12">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                          <TextBlock Text="Tags" Style="{StaticResource XenMotionLabelTextStyle}" />
                          <TextBlock x:Name="TagsHintText" Text="Pick several. A wallpaper must carry every tag you choose." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource XenMotionGhostButtonStyle}" MinHeight="28" Height="28" Padding="10,0" CornerRadius="14" FontSize="12"
                                Foreground="{StaticResource XenMotionMintTextBrush}" Content="Clear" Click="OnClearTagsClicked" VerticalAlignment="Top" />
                      </Grid>
                      <ItemsRepeater x:Name="TagFilterRepeater">
                        <ItemsRepeater.Layout>
                          <UniformGridLayout MinItemWidth="104" MinItemHeight="36" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate x:DataType="vm:FilterChip">
                            <ToggleButton Style="{StaticResource XenMotionChipStyle}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnFilterChipClicked" HorizontalAlignment="Stretch" MinHeight="36" Padding="8,0">
                              <TextBlock TextTrimming="CharacterEllipsis"><Run Text="#" Foreground="{StaticResource XenMotionMintTextBrush}" /><Run Text="{x:Bind Label}" /></TextBlock>
                            </ToggleButton>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FilterSummaryText" Style="{StaticResource XenMotionCaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="1" Style="{StaticResource XenMotionButtonStyle}" Content="Reset" Click="OnResetFiltersClicked" />
              <Button Grid.Column="2" Style="{StaticResource XenMotionPrimaryButtonStyle}" Content="Done" Click="OnFiltersToggleClicked" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- ============================ NOW PLAYING DOCK ============================ -->
    <Border x:Name="NowPlayingPanel" Style="{StaticResource XenMotionGlassStrongPanelStyle}" CornerRadius="26" Padding="14,10,10,10"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,22" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Border Width="40" Height="40" CornerRadius="15" Background="{StaticResource XenMotionAccentSoftBrush}" BorderBrush="{StaticResource XenMotionAccentRimBrush}" BorderThickness="1" VerticalAlignment="Center">
          <FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE93E;" FontSize="16" Foreground="{StaticResource XenMotionMintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="0" MinWidth="120" MaxWidth="240">
          <TextBlock Text="NOW PLAYING" Style="{StaticResource XenMotionEyebrowTextStyle}" FontSize="9" />
          <TextBlock x:Name="NowPlayingTitleTextBlock" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource XenMotionTextBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="PauseResumeButton" Style="{StaticResource XenMotionIconButtonStyle}" Width="38" Height="38" MinHeight="38" CornerRadius="19" Click="OnPauseResumeClicked">
            <FontIcon x:Name="NowPlayingPauseIcon" Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE769;" FontSize="14" />
          </Button>
          <Slider x:Name="NowPlayingVolumeSlider" Width="110" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OnPlaybackVolumeChanged" ToolTipService.ToolTip="Wallpaper volume" />
          <TextBlock x:Name="NowPlayingVolumeText" Width="38" VerticalAlignment="Center" Text="100%" />
          <Button Style="{StaticResource XenMotionIconButtonStyle}" Width="38" Height="38" MinHeight="38" CornerRadius="19" Click="OnMuteClicked" ToolTipService.ToolTip="Mute / unmute">
            <FontIcon x:Name="NowPlayingMuteIcon" Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE767;" FontSize="14" />
          </Button>
          <Button Style="{StaticResource XenMotionIconButtonStyle}" Width="38" Height="38" MinHeight="38" CornerRadius="19" Click="OnStopClicked" ToolTipService.ToolTip="Stop and restore the normal wallpaper"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE71A;" FontSize="13" /></Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ============================ TOAST ============================ -->
    <Border x:Name="ToastHost" Style="{StaticResource XenMotionGlassStrongPanelStyle}" CornerRadius="20" Padding="16,12,10,12"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Opacity="0" Visibility="Collapsed" MaxWidth="560">
      <Border.OpacityTransition><ScalarTransition Duration="0:0:0.22" /></Border.OpacityTransition>
      <Border.TranslationTransition><Vector3Transition Duration="0:0:0.28" /></Border.TranslationTransition>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border x:Name="ToastIconHost" Width="30" Height="30" CornerRadius="11" Background="{StaticResource XenMotionAccentSoftBrush}" VerticalAlignment="Center">
          <FontIcon x:Name="ToastIcon" Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource XenMotionMintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="ToastText" FontSize="13" Foreground="{StaticResource XenMotionTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
        <Button Style="{StaticResource XenMotionSmallIconButtonStyle}" Background="Transparent" BorderThickness="0" Click="OnToastCloseClicked" VerticalAlignment="Center"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE711;" FontSize="11" /></Button>
      </StackPanel>
    </Border>

    <!-- ============================ DOWNLOAD SHEET ============================ -->
    <Grid x:Name="DownloadOverlay" Visibility="Collapsed" Opacity="0">
      <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Grid.OpacityTransition>
      <Rectangle Fill="{StaticResource XenMotionScrimBrush}" Tapped="OnDownloadBackdropTapped" />
      <Border x:Name="DownloadPanel" Style="{StaticResource XenMotionGlassStrongPanelStyle}" CornerRadius="30" Width="440" Padding="18"
              HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="OnDialogPanelTapped">
        <Border.TranslationTransition><Vector3Transition Duration="0:0:0.3" /></Border.TranslationTransition>
        <StackPanel Spacing="16">
          <Border Height="190" CornerRadius="22" BorderBrush="{StaticResource XenMotionRimBrush}" BorderThickness="1">
            <Border.Background>
              <ImageBrush x:Name="DownloadPreviewBrush" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <StackPanel Spacing="4" Margin="6,0">
            <TextBlock x:Name="DownloadHeadlineText" Style="{StaticResource XenMotionEyebrowTextStyle}" />
            <TextBlock x:Name="DownloadTitleText" Style="{StaticResource XenMotionTitleTextStyle}" FontSize="22" TextWrapping="Wrap" />
            <TextBlock x:Name="DownloadSpecsText" Style="{StaticResource XenMotionCaptionTextStyle}" FontSize="12" />
          </StackPanel>
          <Border Style="{StaticResource XenMotionSectionStyle}" Padding="14,12" Margin="0">
            <StackPanel Spacing="10">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource XenMotionMintTextBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Saved to your library" Style="{StaticResource XenMotionLabelTextStyle}" />
                  <TextBlock x:Name="DownloadLocationText" Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Height="4" Visibility="Collapsed" />
              <TextBlock x:Name="DownloadStateText" Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
          </Border>
          <Grid ColumnSpacing="10" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DownloadSecondaryButton" Grid.Column="0" Style="{StaticResource XenMotionButtonStyle}" HorizontalAlignment="Stretch" Height="46" CornerRadius="16" Content="Not now" Click="OnDownloadSecondaryClicked" />
            <Button x:Name="DownloadPrimaryButton" Grid.Column="1" Style="{StaticResource XenMotionPrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="46" CornerRadius="16" Content="Download" Click="OnDownloadPrimaryClicked" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============================ SETTINGS SHEET ============================ -->
    <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Opacity="0">
      <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Grid.OpacityTransition>
      <Rectangle Fill="{StaticResource XenMotionScrimBrush}" Tapped="OnSettingsBackdropTapped" />
      <Border x:Name="SettingsPanel" Style="{StaticResource XenMotionGlassStrongPanelStyle}" Background="{StaticResource XenMotionPageBrush}" CornerRadius="30" Width="560"
              HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,18,18,18" Tapped="OnDialogPanelTapped">
        <Border.TranslationTransition><Vector3Transition Duration="0:0:0.32" /></Border.TranslationTransition>
        <Grid Padding="24,22,24,20" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid x:Name="SettingsMintGlowHost" Width="520" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-240,-240,0,0" Grid.RowSpan="4" IsHitTestVisible="False" />
          <Grid x:Name="SettingsVioletGlowHost" Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-350,-390" Grid.RowSpan="4" IsHitTestVisible="False" />
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SettingsDragRegion" Background="Transparent" Spacing="2">
              <TextBlock Text="PREFERENCES" Style="{StaticResource XenMotionEyebrowTextStyle}" />
              <TextBlock Text="Settings" Style="{StaticResource XenMotionTitleTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource XenMotionSmallIconButtonStyle}" VerticalAlignment="Top" Click="OnCloseSettingsClicked"><FontIcon Style="{StaticResource XenMotionIconStyle}" Glyph="&#xE711;" FontSize="12" /></Button>
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource XenMotionGlassPanelStyle}" CornerRadius="15" Padding="4">
            <Grid ColumnSpacing="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <ToggleButton x:Name="SettingsTabGeneral" Grid.Column="0" Style="{StaticResource XenMotionTabStyle}" HorizontalAlignment="Stretch" Tag="General" Click="OnSettingsTabClicked" Content="General" />
              <ToggleButton x:Name="SettingsTabPlayback" Grid.Column="1" Style="{StaticResource XenMotionTabStyle}" HorizontalAlignment="Stretch" Tag="Playback" Click="OnSettingsTabClicked" Content="Playback" />
              <ToggleButton x:Name="SettingsTabPerformance" Grid.Column="2" Style="{StaticResource XenMotionTabStyle}" HorizontalAlignment="Stretch" Tag="Performance" Click="OnSettingsTabClicked" Content="Performance" />
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <ScrollViewer x:Name="SettingsGeneralSection" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
              <StackPanel Spacing="14">
                <Border Style="{StaticResource XenMotionSectionStyle}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Your name" Style="{StaticResource XenMotionLabelTextStyle}" />
                    <Border Style="{StaticResource XenMotionFieldStyle}" Height="44">
                      <TextBox x:Name="SettingsDisplayNameTextBox" Style="{StaticResource XenMotionTextBoxStyle}" VerticalAlignment="Center" PlaceholderText="How should XenMotion call you?" TextChanged="OnSettingsDisplayNameChanged" />
                    </Border>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource XenMotionSectionStyle}">
          <StackPanel Spacing="12">
            <Grid ColumnSpacing="16" MinHeight="48">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Launch with Windows" Style="{StaticResource XenMotionLabelTextStyle}" />
                <TextBlock Text="Start XenMotion quietly when you sign in." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleButton x:Name="SettingsStartWithWindowsToggle" Grid.Column="1" Style="{StaticResource XenMotionSwitchStyle}" Click="OnSettingsToggleClicked" />
            </Grid>
            <Rectangle Height="1" Fill="{StaticResource XenMotionDividerBrush}" />
            <Grid ColumnSpacing="16" MinHeight="48">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Start in the tray" Style="{StaticResource XenMotionLabelTextStyle}" />
                <TextBlock Text="Skip the window and stay in the system tray." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleButton x:Name="SettingsStartMinimizedToggle" Grid.Column="1" Style="{StaticResource XenMotionSwitchStyle}" Click="OnSettingsToggleClicked" />
            </Grid>
          </StackPanel>
        </Border>
                <Border Style="{StaticResource XenMotionSectionStyle}">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Windows personalization" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Sync once when you change wallpapers. Videos use a cached still image. Disabling sync keeps the current Windows appearance." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
                    <ToggleButton x:Name="SettingsSyncAccentToggle" Style="{StaticResource XenMotionChipStyle}" Content="Match Windows accent color" Click="OnSettingsToggleClicked" />
                    <TextBlock Text="Enables Windows automatic accent color and updates its static background. Windows chooses the color from that image." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
                    <ToggleButton x:Name="SettingsSyncBackgroundToggle" Style="{StaticResource XenMotionChipStyle}" Content="Match static desktop background" Click="OnSettingsToggleClicked" />
                    <TextBlock Text="Shows the matching still before XenMotion starts at sign-in." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
                    <ComboBox x:Name="SettingsLockScreenCombo" Header="Lock screen / sign-in image" SelectionChanged="OnLockScreenModeChanged" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="Keep Windows setting" />
                      <ComboBoxItem Content="Use desktop wallpaper still" />
                      <ComboBoxItem Content="Use a separate image" />
                    </ComboBox>
                    <Button Content="Choose separate image" Click="OnPickLockScreenImageClicked" />
                    <TextBlock x:Name="SettingsLockScreenImageText" TextWrapping="Wrap" Style="{StaticResource XenMotionCaptionTextStyle}" />
                    <TextBlock Text="Windows supports a static lock screen only. To also show it behind sign-in, enable Show the lock screen background picture on the sign-in screen in Windows Settings." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource XenMotionSectionStyle}">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Wallpaper server" FontSize="18" FontWeight="SemiBold" />
                    <ToggleButton x:Name="SettingsRemoteCatalogToggle" Style="{StaticResource XenMotionChipStyle}" Content="Use online catalog" Click="OnSettingsToggleClicked" />
                    <TextBox x:Name="SettingsCatalogUrlText" Header="HTTPS server base URL" PlaceholderText="https://catalog.example.com/" TextChanged="OnAdvancedTextChanged" />
                    <NumberBox x:Name="SettingsCatalogTimeoutNumber" Header="Request timeout (seconds)" Minimum="1" Maximum="60" SmallChange="1" ValueChanged="OnCatalogTimeoutChanged" />
                    <ToggleButton x:Name="SettingsLocalFallbackToggle" Style="{StaticResource XenMotionChipStyle}" Content="Use local catalog when server is unavailable" Click="OnSettingsToggleClicked" />
                    <TextBlock Text="Save and restart to change catalog servers. Downloads support progress, cancellation and resume. Leave online catalog disabled until your server is ready." Style="{StaticResource XenMotionCaptionTextStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
