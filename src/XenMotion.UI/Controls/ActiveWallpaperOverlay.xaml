<UserControl
    x:Class="XenMotion.UI.Controls.ActiveWallpaperOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
  <Grid>
    <Border x:Name="GlowFrame" CornerRadius="18" BorderThickness="3" Opacity="0.65">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF5EF2CF" Offset="0" />
          <GradientStop Color="#004FD8FF" Offset="0.4" />
          <GradientStop Color="#FF8B7BFF" Offset="0.7" />
          <GradientStop Color="#FF5EF2CF" Offset="1" />
        </LinearGradientBrush>
      </Border.BorderBrush>
    </Border>
    <Border x:Name="LiveBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="11" CornerRadius="12" Padding="9,5"
            Background="#E0102530" BorderBrush="#AA5EF2CF" BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Grid Width="14" Height="14" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
            <Border x:Name="BarOne" Width="3" Height="9" CornerRadius="1.5" Background="#FF5EF2CF" />
            <Border x:Name="BarTwo" Width="3" Height="14" CornerRadius="1.5" Background="#FF4FD8FF" />
            <Border x:Name="BarThree" Width="3" Height="11" CornerRadius="1.5" Background="#FF8B7BFF" />
          </StackPanel>
        </Grid>
        <TextBlock x:Name="StateText" Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="#FFB8FFF0" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
